---
// index feature card
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    id: any;
    url: string;
     
    title: string;
    subtitle?: string;
    description?: string;

    status?: string;
    eventType?: string;
    discipline?: string;
    footwear?: string;
    
    locationLabel: string;
    dateLabel: string;
    timeframe?: {
        startDate: Date | string;
        endDate?: Date | string | null;
    };
    poster: ImageMetadata;
    alt: string;
    caption?: string;
    isPlaceholder?: boolean;
    // poster: {
    //     src: ImageMetadata;
    //     alt: string;
    //     caption: string;
    //     isPlaceholder: boolean;
    // }
}

const { 
    id,
    url, 
    poster,
    alt,
    caption,
    isPlaceholder, 
    title, 
    subtitle,
    description,
    status, 
    eventType, 
    discipline,
    footwear,
    locationLabel, 
    dateLabel, 
    timeframe,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---
<!-- TODO change the CSS for missing featured posters -->

<div class=" feature-case">
    <div class="feature-card">
     <div class="feature-case">
    <div class="feature-card">
        <Image 
            class={isPlaceholder ? "feature-poster-placeholder" : "feature-poster"}
            src={poster} 
            alt={alt} 
            width={420} 
            height={500} 
        />
        
        <div class="feature-content">
            <hgroup>
                <h5 class="ft-title">
                    <a href={url} class="main-link">{title}</a>
                </h5>
                <p class="ft-subtitle">{subtitle}</p>
            </hgroup>
            <span class="city-country">📍{locationLabel}</span>
            <span class="event-date">{dateLabel}</span>
            <span class="event-type">{eventType}</span>
            <p>{description}</p>
        </div>
    </div>
</div>
</div>
    <h4 class="feature-title" aria-label="Event Title">{title}</h4>
</div>

<style>

    

.feature-case{
    flex: 0 2 26rem ;
    width: 100%;
    max-width: 26rem;
    margin: 0 auto;

}

@media (max-width: 580px){
    .feature-case{
        max-width: 16.6rem;
        margin-block: 1rem;
    }

    .feature-title{
        text-align: center;
    }
}

.feature-card {
    /* max-width: 420px; */
    /* width: 100%; */
    aspect-ratio: 4 / 5; 
    position: relative;

    display: grid;
    grid-template-rows: repeat(5, 20%);

    border: 2px solid var(--ow-brown);
    border-radius: 8px;
    justify-self: center;
    overflow: hidden;
    
    transition: all .3s;
}
.feature-poster-placeholder{
    
}

.feature-poster, .ft-content {
    grid-row: 1 / -1;
    grid-column: 1;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    height: 100%;
    object-position: center;
    
    transition: transform 0.3s ease;
    
}

.feature-content{
    grid-row: 1 / -1 ;
    grid-column: 1;
    background-color: var(--second-brown);
    color: var(--text-white);
    gap: var(--space-sm);
    
    display: flex;
    flex-direction: column;
    align-items: center;
    align-content: center;
    justify-items: center;
    font-weight: 700;
    padding: var(--space-md);
    opacity: 0;
    
    transition: opacity .6s ease-in-out;
    
}

.feature-card:hover .feature-content {
    opacity: 96%;
}

.ft-content{
    grid-row: 1 / -1 ;
    grid-column: 1;
    background-color: var(--shadow-brown-2);
    color: var(--text-white);
    gap: var(--space-sm);
    
    display: flex;
    flex-direction: column;
    align-items: center;
    align-content: center;
    justify-items: center;
    font-weight: 700;
    padding: var(--space-md);
    
    transition: background-color .6s ease-in-out;
}
.feature-card:hover .ft-content {
    background-color: var(--second-brown);
}

.ft-title {
    max-width: 100%;
    text-wrap: balance;
    text-transform: uppercase;
    text-align: center;
    justify-self: center;
}

.main-link {
    color: var(--text-white);
    font-size: var(--fs-heading-xl);
    text-wrap: balance;

}

.main-link::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10; 
}

.feature-content p, .feature-content span {
    position: relative;
    z-index: 11; 
    pointer-events: none; 
}

.feature-title {
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-self: center;
    justify-content: center;
    max-width: 55ch;
    margin-block: 0.5rem;
    font-size: minmax(var(--fs-heading-mid), var(--fs-heading-xl));
    text-transform: capitalize;
}

.feature-case:hover .feature-title{
    visibility: hidden;
    opacity: 0;
}


.event-type{
    text-transform: uppercase;
    margin: .3rem 0;
    padding: .1rem 1rem;
    border:  1px solid var(--mid-brown);
    background-color: var(--mid-yellow);
    border-radius: 8px;
    color: var(--text-black);

}

.event-date{

}

.city-country{
    margin-bottom: .8rem;
}

@media (max-width: 780px) {

    .feature-case {
        width: 100%;
        padding: 0 1rem; 
    }
    
    .feature-content {
        padding: 1.5rem; 
    }

    .feature-title {
        font-size: var(--fs-heading-mid); 
    }
}

</style>

