---
import Button from "../../components/button.astro";
import PersonField from "../../components/form/fields/personField.astro";
import LocationPicker from '../../components/form/fields/locationSelect.astro';
import SocialSelect from "../../components/form/fields/socialSelect.astro";
import NameField from "./fields/nameField.astro";
import GalleryField from "./fields/galleryField.astro";

import { SKILL_LEVEL, SKATE_DISCIPLINES,  } from "../../data/skate-constants";

const form = "gen";


---
          
<hgroup class="form-title-group">
    <h3 class="form-title">General Skate Event</h3>
    <p>Required fields will be marked with a <span class="req-star">*</span></p>
</hgroup>

 <form 
action="https://submit-form.com/your-id" 
method="POST" 
enctype="multipart/form-data"
class="form-standard"
>

<input type="hidden" name="form_category" value="Skate general" />

<input type="text" name="_honeypot" style="display:none" tabindex="-1" autocomplete="off" />

<!-- who/what/where/when/why -->
<section class="form-section" id={`${form}-base-section`} >

    <NameField form={form}/>
        
</section>

<section class="form-section" id={`${form}-local-section`} >

    <fieldset class="form-field">
        <legend class="field-title">Main Location of Operations:</legend>
        <LocationPicker form={form}/>
        
    </fieldset>

</section>

<section class="form-section" id={`${form}-details-section`} >

    <div class="form-field">
        <label for={`${form}-discipline`} class="field-title"> Skate Dicipline?<span class="req-star">*</span></label>
        <select name={`${form}-discipline`} id={`${form}-discipline`} class="mid-fit field-box" aria-required="true" aria-invalid="false" required>
             {SKATE_DISCIPLINES.map(d => <option value={d.value}>{d.label}</option>)}
        </select>
    </div>

    <div class="form-field">
        <label for={`${form}-boot-req`}>Footwear requirement? <span class="req-star">*</span> </label>
        <select name={`${form}-boot-req`} id={`${form}-boot-req`} data-tooltip="Some events are off-skates but FOR skaters, some are hybrid" required>
            <option value="skates">Skates</option>
            <option value="shoes">Shoes</option>
            <option value="hybrid">Hybrid</option>
        </select>
        <span class="">Is there space for a dancefloor? or is it rink only?</span>
    </div>
    
    <div class="form-field">
        <label for={`${form}-level-select`}> Level requirement
            
        </label>
        <select name={`${form}-level-select`} id={`${form}-level-select`} class=""  aria-invalid="false" >
            {SKILL_LEVEL.map(l => (<option value={l.value}> {l.label}</option>))}
            
        </select>
    </div>

    <div class="form-field">
        <label for={`${form}-minage`}>Minimum Age:</label>
        <input type="text" id={`${form}-minage`} placeholder="21+" required>
    </div>
        
    <div class="form-field">
        <label for={`${form}-maxage`}>Max Age:</label>
        <input type="text" id={`${form}-maxage`} >
    </div>
   
    <div class="form-field">
        <label for={`${form}-post-link`}>Event post:</label>
        <input type="url" id={`${form}-post-link`} placeholder="Your social media post">
    </div>

    <div class="form-field">
        <label for={`${form}-ticket-link`}>Ticket Link:</label>
        <input type="url" id={`${form}-ticket-link`} placeholder="Your social media post">
    </div>
    
    
    <div class="form-field">
        <label for="gen-minage">Skate Rink:</label>
        <input type="text" id="gen-minage" >
    </div>
    
    <div class="form-field">
        <label for={`${form}-rink`}>Featured Rink(s):</label>
        <input type="text" id={`${form}-rink`} placeholder="Skateland, Sparkles,...">
    </div>

</section>

<section class="form-section" id={`${form}-media-section`} >
   
<GalleryField form={form} />
</section>


<section class="form-section" id={`${form}-persons-section`} >

    <hgroup class="field-title-group">
        <p class="field-title">Event Team: </p>
        <p></p>
        <span id="add-hint">All fields are optional. One Person per line. Use the "Add Person" button to add more fields</span>
    </hgroup>
    
    <PersonField role="Organiser" fieldName="organiser" />
    
    <PersonField role="DJ" fieldName="dj" />
    
    

</section>

    <div class="btn-wrap form-field">
        <Button variant="tertiary" size="lg" theme="purpleLight" type="submit">Submit Event</Button>
    </div>

</form>
<!-- EVENT FORM END -->