---
import { CONTINENT_DATA } from '../../../data/globe-constants';
import { slugify } from '../../../function/stringHelper';

const geoData = CONTINENT_DATA.map(c => ({
  slug: slugify(c.continent),
  countries: c.countries
}));


interface Props {
    form?: string;
    no?: string;
    fieldLegend: string;
    [x: string]: any;
}

const {
    form, 
    no,
    fieldLegend,
    ...rest

} = Astro.props;
---
<fieldset class="form-field location-picker-container">
  <legend class="field-title">{fieldLegend}</legend>

  <div class="location-selector-container form-field">
    <div class="form-field continent-wrapper">
      <label for="continent" class="block text-sm font-bold">Continent<span class="req-star">*</span></label>
      <select id={`${form}-continent`} class="continent-select form-input" name="location.discriminant">
        {CONTINENT_DATA.map(c => (
          <option value={slugify(c.continent)}>{c.continent}</option>
        ))}
      </select>
    </div>

    <div class="form-field country-wrapper">
      <label for={`${form}-country`} class="block text-sm font-bold">Country<span class="req-star">*</span></label>
      <select id={`${form}-country`} class="country-select form-input" name="location.value.discriminant">
        </select>
    </div>

    <div class="region-container region-wrapper form-field hidden">
      <label for={`${form}-region`} class="block text-sm font-bold">Region / Nation</label>
      <select id={`${form}-region`} class="region-select form-input" name="location.value.value.discriminant">
        </select>
    </div>
  </div>


  <div class=" town-container form-field">
    <label for={`${form}-town-city-field`}>Town / City <span class="req-star">*</span></label>
    <input type="text" id={`${form}-town-city-field`} name="town_city" placeholder="e.g. Leeds" minlength="3" class="form-input" required>
  </div>
  
  <div class="address-fields form-field">
    <p class="small-heading">Street Address:</p>
    <label for={`${form}-1lineadd`} class="srOnly">Adress First Line</label>
    <input id={`${form}-1lineadd`} type="text" name="address_line_1" placeholder="Building number and street name" />
    <label for={`${form}-2lineadd`} class="srOnly">Address second Line</label>
    <input id={`${form}-2lineadd`} type="text" name="address_line_2" placeholder="Suite, Unit, or Floor (Optional)" />
    <label for={`${form}-3lineadd`} class="srOnly">Address Post Code</label>
    <input id={`${form}-3lineadd`} type="text" name="post_code" placeholder="Postcode / ZIP" />
  </div>

</fieldset>

<script>
  import { CONTINENT_DATA, getRegionOptions } from '../../../data/globe-constants';
  import { slugify } from '../../../function/stringHelper';

  function initLocationPickers() {
    const containers = document.querySelectorAll('.location-picker-container');

    containers.forEach(container => {
      // Prevent double-initialization
      if ((container as HTMLElement).dataset.initialized === 'true') return;

      const contSelect = container.querySelector('.continent-select') as HTMLSelectElement;
      const countrySelect = container.querySelector('.country-select') as HTMLSelectElement;
      const regionSelect = container.querySelector('.region-select') as HTMLSelectElement;
      const regionWrapper = container.querySelector('.region-container') as HTMLElement;

      if (!contSelect || !countrySelect) return;

      // UPDATE COUNTRIES
      contSelect.addEventListener('change', () => {
        const selectedSlug = contSelect.value;
        
        // Reset children
        countrySelect.innerHTML = '<option value="">-- Select Country --</option>';
        regionSelect.innerHTML = '<option value="">-- Select Region --</option>';
        regionSelect.disabled = true;
        regionWrapper.classList.add('hidden');

        if (selectedSlug) {
          const continentData = CONTINENT_DATA.find(c => slugify(c.continent) === selectedSlug);
          
          if (continentData) {
            continentData.countries.forEach(country => {
              const opt = document.createElement('option');
              opt.value = country.value;
              opt.textContent = country.label;
              opt.dataset.hasRegions = country.hasRegions ? "true" : "false";
              countrySelect.appendChild(opt);
            });
            countrySelect.disabled = false;
          }
        } else {
          countrySelect.disabled = true;
        }
      });

      // UPDATE REGIONS
      countrySelect.addEventListener('change', () => {
        const selectedCountry = countrySelect.value;
        const selectedOption = countrySelect.options[countrySelect.selectedIndex];
        const hasRegions = selectedOption.dataset.hasRegions === "true";

        regionSelect.innerHTML = '<option value="">-- Select Region --</option>';

        if (hasRegions && selectedCountry) {
          const regions = getRegionOptions(selectedCountry);
          if (regions.length > 0) {
            regions.forEach(reg => {
              const opt = document.createElement('option');
              opt.value = reg.value;
              opt.textContent = reg.label;
              regionSelect.appendChild(opt);
            });
            regionSelect.disabled = false;
            regionWrapper.classList.remove('hidden');
          } else {
            hideRegion();
          }
        } else {
          hideRegion();
        }
      });

      function hideRegion() {
        regionSelect.disabled = true;
        regionWrapper.classList.add('hidden');
      }

      (container as HTMLElement).dataset.initialized = 'true';
    });
  }

  // Initialize
  initLocationPickers();
  document.addEventListener('astro:after-swap', initLocationPickers);
</script>

<style>
  .location-picker-container {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    width: 100%;
    margin-bottom: 1rem;
    align-items: center;
  }

  .town-container {
    display: flex;
    flex-direction: column;
    width: 60%;
  }
  
  
  .form-input:disabled {
    background-color: #f0f0f0;
    cursor: not-allowed;
    opacity: 0.6;
    border-color: #ddd;
  }

  .address-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}


@media (max-width: 780px) {
  .location-picker-container {
    display: flex;
    flex-direction: column;
    grid-template-columns: 1fr; 
    gap: 1rem;
  }
  

  
    .form-field {
      width: 100%;
    }
    
    .form-input{
      height: 3rem;
      padding: .4rem;
    }
    
    .location-picker-container {
      grid-template-columns: 1fr; 
    }

    .address-fields{
        flex-direction: column;
        width: 100%;
        box-sizing: border-box;
    }
  }

  /* 1. State-based styling */
.form-input:disabled {
  background-color: #f3f4f6; /* Light gray */
  cursor: not-allowed;
  opacity: 0.6;
  border-color: #d1d5db;
}

/* 2. Smooth reveal for the Region field */
.region-container {
  transition: all 0.3s ease-in-out;
  max-height: 200px;
  opacity: 1;
  overflow: hidden;
}

/* When hidden, collapse and fade out */
.region-container.hidden {
  display: block !important; /* Overriding 'hidden' to allow animation */
  max-height: 0;
  opacity: 0;
  margin-top: 0;
  margin-bottom: 0;
  pointer-events: none;
}


</style>