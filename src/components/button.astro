---
// theme?: 'orangeLight' | 'tealLight' | 'purpleLight' | 'pinkLight' | 'brownLight' | 'whiteLight' | 'blackLight' | 'yellowLight' | 'orangeDark' | 'tealDark' | 'purpleDark' | 'pinkDark' | 'brownDark' | 'whiteDark' | 'blackDark' | 'yellowDark' | 'orange' | 'pink' | 'teal' | 'purple' | 'yellow' | 'brown' | 'white' | 'black';

type Color = 'orange' | 'pink' | 'teal' | 'purple' | 'yellow' | 'brown' | 'white' | 'black';
type Suffix = 'Light' | 'Dark';


interface Props {
  href?: string;          
  theme?: Color | `${Color}${Suffix}`;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'outline' ;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  class?: string;          
  [x: string]: any;        
}

const { 
  href, 
  theme = 'brownDark',
  variant = 'secondary', 
  size = 'md', 
  class: className, 
  ...rest 
} = Astro.props;

// Determine the HTML element based on whether an href is provided
const Element = href ? 'a' : 'button';

// Mapping variants to CSS classes
const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  tertiary: 'btn-tertiary',
  outline: 'btn-outline',
};

const sizeClasses = {
    xs: 'btn-xs',
    sm: 'btn-sm',
    md: 'btn-md',
    lg: 'btn-lg'
};

const themeColour = {
  orangeDark: 'orange-dark',
  pinkDark: 'pink-dark',
  tealDark: 'teal-dark',
  purpleDark: 'purple-dark',
  brownDark: 'brown-dark',
  whiteDark: 'white-dark',
  blackDark: 'black-dark',
  yellowDark: 'yellow-dark',
  
  orangeLight: 'orange-light',
  pinkLight: 'pink-light',
  tealLight: 'teal-light',
  purpleLight: 'purple-light',
  brownLight: 'brown-light',
  whiteLight: 'white-light',
  blackLight: 'black-light',
  yellowLight: 'yellow-light',

  orange: 'orange',
  pink: 'pink',
  teal: 'teal',
  purple: 'purple',
  brown: 'brown',
  white: 'white',
  black: 'black',
  yellow: 'yellow',

};

---

<Element 
  href={href} 
  class:list={[
    'btn', 
    variantClasses[variant], 
    sizeClasses[size], 
    themeColour[theme],
    className
  ]} 
  {...rest}
>
  <slot /> </Element>

<style>
  /* Base Styles */
.btn {
  margin: .1rem;
  display: inline-flex;
  min-height: 1rem;
  align-items: center;
  justify-content: center;
  vertical-align: middle;

  font-weight: 600;
  letter-spacing: .3ch;
  text-align: center;
  font-family: 'Red Rose';
  text-decoration: none;
  transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

/* Sizes */
.btn-xs { padding: 0.3rem 0.8rem; font-size: 0.775rem; }
.btn-sm { padding: 0.5rem .6rem; font-size: 0.895rem; }
.btn-md { padding: 0.6rem 1rem; font-size: 1rem; }
.btn-lg { padding: 0.8rem 1.2rem; font-size: 1.1rem; }

/* ------------------ PRIMANRY BUTTON */
.btn-primary {
  min-height: 2.8rem;
  min-width: 18ch;
  border-radius: 15px ;
  border-width: .3rem;
  border-style: solid double double;
  
  box-shadow: 4px 0 15px var(--shadow-pink-3);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 6px -1px var(--shadow-brown);
  scale: 1.03;
}

/* ------------------ SECONDARY BUTTON */
.btn-secondary {
  min-width: 18ch;
  min-height: 2.9rem;
  border-radius: 27px;
  border-width: 6px;
  border-style: solid;

  box-shadow: 4px 4px 0px var(--shadow-purple-3);
}

.btn-secondary:hover{
  box-shadow: 0 4px 6px -1px var(--shadow-brown);
  scale: 1.03;
}

/* ------------------ TERTIARY BUTTON */
.btn-tertiary {
  border-radius: 4px 16px 16px 16px;
  border-width: 4px;
  border-style: double;
  box-shadow: 2px 4px 8px var(--shadow-grey);
}

.btn-tertiary:hover{
  box-shadow: 0 4px 6px -1px var(--shadow-brown);
  border-radius: 16px 4px 16px 16px;
  scale: 1.04;
    
}

/* ------------------ OUTLINE BUTTON */
.btn-outline {
  background-color: transparent;
  border-radius: 8px;
  text-transform: uppercase;
  background-color: none;
  border-width: 6px;
  border-style: double;
}

.btn-outline:hover {
  border-style: solid;
  scale: 1.04;
}

.btn:active {
  transform: translateY(0);
}

/* --------------- THEME COLOUR ---------------- */

/* for light theme */
