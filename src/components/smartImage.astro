---
import { Image } from 'astro:assets';

interface Props {
  src: any; // Astro's image object
  alt: string;
  aspectRatio?: string; // e.g., "16/9", "4/3", "1/1"
  objectPosition?: string; // e.g., "center", "80% 20%"
  className?: string;
  loading?: "lazy" | "eager";
}

const { 
  src, 
  alt, 
  aspectRatio = "16/9", 
  objectPosition = "center",
  className = "" ,
  loading = "lazy"
} = Astro.props;
---

<div 
  class={`smart-image-container ${className}`} 
  style={`--aspect-ratio: ${aspectRatio};`}
>
  <div class="skeleton-overlay"></div>

  <Image 
    src={src} 
    alt={alt} 
    loading={loading}
    class="smart-img"
    style={`object-position: ${objectPosition};`}
    onload="this.classList.add('is-loaded')"
  />
</div>

<style>
  .smart-image-container {
    width: 100%;
    aspect-ratio: var(--aspect-ratio);
    position: relative;
    overflow: hidden;
    background-color: #e2e8f0; /* Base gray */
  }

  /* --- SKELETON ANIMATION --- */
  .skeleton-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #e2e8f0 25%,
      #f8fafc 50%,
      #e2e8f0 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite linear;
    z-index: 1;
  }

  @keyframes shimmer {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }

  /* --- IMAGE STYLING --- */
  .smart-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
    
    /* Start invisible for fade-in effect */
    opacity: 0;
    transition: opacity 0.6s ease-in-out, transform 0.4s ease-out;
  }

  /* This class is added via the onload JS snippet above */
  .smart-img.is-loaded {
    opacity: 1;
  }

  /* Hide skeleton once image is loaded to save CPU */
  .smart-img.is-loaded + .skeleton-overlay {
    display: none;
  }

  /* Optional: Subtle zoom on container hover */
  .smart-image-container:hover .smart-img.is-loaded {
    transform: scale(1.03);
  }

  @supports not (aspect-ratio: 16/9) {
  .smart-image-container {
    padding-top: 56.25%; /* 16:9 fallback */
    height: 0;
  }
  .smart-img {
    position: absolute;
    top: 0; left: 0;
  }
}
</style>