---
// blog index card holders
import React from 'react';
import { Image } from "astro:assets";

import type { SerializedBlog, BlogCardData } from '../function/types';
import { formatEventDate } from '../function/dateHelper';

import BlogPlaceholder from '../assets/placeholder/placeholder-blogPoster.jpg';

type BlogCardProps = SerializedBlog['data'] & {
  id: string;
}; 


const {
  id,
  title,
  subtitle,
  description,
  skateDiscipline,
  coverImage,
  blogCategory,
  published,
  
} = Astro.props

const posterSrc = coverImage?.src || BlogPlaceholder;
const posterAlt = coverImage?.alt || title;

const dateDisplay = formatEventDate(published);
const cleanSlug = id.replace(/\.[^/.]+$/, "");
// const cleanSlug = id.includes('/') ? id.split('/')[0] : id;
// const cleanSlug = title.includes('/') ? title.split('/')[0] : title;
const postUrl = `/blog/post/${cleanSlug}/`;

const base = import.meta.env.BASE_URL;
---

<article class={`blog-card ${blogCategory}`}>
  
  <div class="card-image-box">
    {coverImage ? (
        <Image src={posterSrc} alt={posterAlt || title} width={500} class="cover-image" />
    ) : (
      <div class='image-replacement'></div>
    )}
  </div> 

  <div class="card-text">
      <hgroup class="card-header">
      <a href={postUrl} class="blog-card-link" aria-label={title}></a>
      <h3 class="blog-title">{title}</h3>
      <p class='blog-subtitle'> {subtitle}</p>
    </hgroup> 

    <div class="card-meta">
      <p class='blog-description'>{description}</p>
      <div class="meta-row">
        <span class="meta-item cate">{blogCategory}</span>
        {skateDiscipline && ( <span class="meta-item disc">{skateDiscipline}</span>)}
        {skateDiscipline && (
          <span class="meta-item disc">
            {skateDiscipline.replace('-', ' ')}
          </span>
        )}
      </div>
    </div>
  </div>

</article>

<style>

  .blog-card{
    position: relative;
    cursor: pointer;

    display: flex;
    flex-direction: row;
    max-width: 880px;
    width: 100%;
    min-height: 14rem;
    gap: 2.4rem;
    padding: 1rem;
    margin-block: 1rem;
    border: 2px double var(--shadow-grey);
    border-radius: 18px;
    background-color: var(--clear-orange);
    /* color: var(--text-white); */
  }

  .blog-card-link{
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
}

 @media (max-width: 580px){
    .blog-card{
      flex-direction: column;


    }

 }

/* -------------------------- IMAGE ----- */
.card-image-box {
  display: flex;
  justify-content: center;
  align-items: center;

  aspect-ratio: 1 / 1;
  width: 15rem;
  border-radius: 12px;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;

}

.image-replacement{
  width: 5rem;

}

  @media (max-width: 580px){

    .image-replacement{
      width: 0;
    }
  }
  

  /* ------------------------ INFO ----- */

  .card-header{
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .blog-title{
    text-transform: uppercase;
  }
  .blog-subtitle{
    padding-left: .3rem;
  }

  .card-meta{
    padding: .5rem;
  }

.meta-row {
  display: flex;
  gap: 1rem;
}

.meta-item {
  display: flex;
  align-items: center; 
  gap: 0.5rem;
  padding: .3rem .8rem;
  font-size: .9rem;
  color: var(--black);
}


.disc {
    /* width: 40%; */
    background-color: var(--ow-teal);
    padding: .3rem .6rem;
    /* width: max-content; */
    font-size: .64rem;
    border-radius: 3px 8px 8px 8px;
    color: var(--main-black);
    text-transform: uppercase;
    
    
}
.cate {
    /* width: 40%; */
    background-color: var(--ow-purple);
    font-size: .64rem;
    padding: .3rem .6rem;
    border-radius: 3px 8px 8px 8px;
    color: var(--main-black);
    text-transform: uppercase;

}



</style>
