---
import "../styles/footer.css";
import { Image } from "astro:assets";

import Socials from "../components/socials.astro" ;
import FootLogo from '/src/assets/YJP/alt-bloat-1.svg'
import CoffeeButton from './ext/coffee-button.astro';
import tradeFrame from '../assets/layout/trade-as-1.svg';

import {OFFICIAL_LINKS} from '../data/site-config';

const base = import.meta.env.BASE_URL;

---

<footer>
    <section id="upperFoot" class=" bold-links">
          
        <div class="up-block">
            <Image src={FootLogo} id="endLogo" alt="YJP Logo" width={150} height={150}  />
        </div>    
        
        <div class="up-block socialLinks">
            <Socials />
        </div>
        
    </section>
    <section id="donate-block">
        <CoffeeButton />

    </section>
    <section id="lowerFoot" class=" bold-links">
        <div class="low-block row2 toe">
            <p>Your Jam Plug UK ®
                Established 2023 <br> [<a href="/terms-of-use/">Terms of Use</a>]  - 
                [<a href="/privacy-policy/">Privacy Policy</a>] - [<a href="/legal">Legal Information</a>] - [<a href="/disclaimer">Disclaimers</a>]
            </p>
        </div>
        <div class="low-block row3 toe">
            <p>
                YOURJAMPLUG.UK is a collective that helps skaters find what they need to enjoy the hobby they love.
            </p>
        </div>
        <div class="low-block row1 toe">
            <p>Email us here: <br> <a href={OFFICIAL_LINKS.helloMail}>{OFFICIAL_LINKS.emailHello}</a>
            </p>
        </div>
    </section>
    <section id="endFooter" class=" simple-links">
        <div class="legal-info end-block">
            <a href="/legal" class="legal-link" aria-label="Legal Information">
                <p>© 2023 The Jam Plug</p>
                <Image 
                src={tradeFrame}
                alt="Business ownership disclosure" 
                width={320} height={60}
                class="trade-as"
                />
            </a>
        </div>

