---
import '../styles/global.css';
import '../styles/components.css'; 
import { formatEventDate, formatTime } from '../function/dateHelper';
import { formatLocation, hasRegionSelected } from '../data/globe-constants';


import Image from 'astro/components/Image.astro';

const { location, townCity } = Astro.props.event.data;
const loc = formatLocation(location, townCity);
const showRegion = hasRegionSelected(location)

const { title, url, description, poster, area, country, start, end, category, type, age } = Astro.props;
const { data } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL

---

<div class="event-item"><a class="list-link" href={url} title={title}>

        <div class="img-wrapper ">
            <Image src={poster} alt={title} class="eventcard-poster" />
        </div>

        <div class="content-wrapper">
            <div class="title-wrap">
                <h6 class="event-name">{title}</h6>
            </div>

            <div class="event-category">
                <div class="flex cat-box-1">
                    <div class="cat-tag">{category}</div>
                    <div class="type-tag">{type}</div>
                </div>
                <div class="flex cat-box-2">
                    {age && <div class="age-tag dataOptional" id="minimum-age-tag">{age}</div>}
                </div>
            </div>

            <div class="meta-wrapper">
                <div class="location-wrapper">
                    <p class="location">{townCity} - {loc.countryLabel}</p>
                    {showRegion && ( <span class="region">{loc.regionLabel}</span>)}
                </div>

                <div class="description-wrapper">
                    <span class="description">{description}</span>
                    <small>Full Address: {loc.full}</small>
                </div>


                <div class="date-wrapper">
                    <span>
                        {formatEventDate(data.startDate, data.endDate)}
                    </span>
                    <span>
                      {formatTime(data.startTime)} 
                        {data.endTime && ` - ${formatTime(data.endTime)}`}
                    </span>
                </div>
            </div>
        </div>
</a></div>


