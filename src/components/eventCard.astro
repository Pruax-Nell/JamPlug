---
import '../styles/global.css';
import '../styles/components.css'; 

import Image from 'astro/components/Image.astro';

const { title, url, description, poster, area, country, start, end, category, type } = Astro.props;
const {frontmatter, data} = Astro.props;
const BASE_URL = import.meta.env.BASE_URL

const formattedDate = start.toLocaleDateString('en-GB', { 
    day: '2-digit',      // DD
    month: 'long',    // MM
    year: '2-digit'      // YY
});

const formattedEndDate = end.toLocaleDateString('en-GB', { 
    day: '2-digit',      // DD
    month: 'long',    // MM
    year: '2-digit'      // YY
});
 
const formattedTime = start.toLocaleTimeString('en-GB', { 
    hour: '2-digit',     // HH
    minute: '2-digit',   // MM
    hour12: false        // Ensures 24-hour clock (e.g., 14:30 instead of 2:30 PM)
});
const formattedEndTime = end.toLocaleTimeString('en-GB', { 
    hour: '2-digit',     // HH
    minute: '2-digit',   // MM
    hour12: false        // Ensures 24-hour clock (e.g., 14:30 instead of 2:30 PM)
});
---

<div class="event-item">
    <a class="events-list-link list-link" href={url} title={title}>
        <div class="img-wrapper">
            <Image src={poster} alt={title} class="eventcard-poster" />
        </div>

        <div class="eg-2">
            <h6 class="event-name">{title}</h6>
        </div>
        <div>
            <div class="cat-tag">{category}</div>
            <div class="cat-tag">{type}</div>
        </div>

        <div class="content-wrapper">
            <div class="meta-wrapper">
                <div>
                    <span>{description}</span>
                </div>
                <div class="location-wrapper">
                    <p class="location">{area} - {country}</p>
                </div>
                <div class="date-wrapper">
                    <span>
                        Date: <span>{formattedDate}</span> to <span>{formattedEndDate}</span>
                    </span>
                    <span>
                        Times: <span>{formattedTime}</span> to <span>{formattedEndTime}</span>
                    </span>
                </div>
            </div>
        </div>
    </a>
</div>




