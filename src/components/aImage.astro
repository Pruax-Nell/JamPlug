---
import { Image } from "astro:assets";
const { src, alt, caption } = Astro.props;
---
<figure class="standard-image-container">
  <div class="standard-frame">
    <Image src={src} alt={alt || "YJP Image"} width={1000}  />
  </div>
  {alt && <figcaption>{caption}{alt}</figcaption>}
</figure>

<style>
  .standard-image-container {
    margin: 2rem auto; 
    width: 100%;
    max-width: 400px; 
  }

  .standard-frame {
    border-radius: 12px;
    overflow: hidden;
    border: 3px solid var(--shadow-grey);
    display: block;
    aspect-ratio: attr(width) / attr(height); 
  }

  .standard-frame img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }


  figcaption {
    margin-top: 0.5rem;
    font-size: var(--fs-caption);
    text-align: center;
    font-style: italic;
    opacity: 0.7;
  }
</style>