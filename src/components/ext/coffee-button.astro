<div class="coffee-container" aria-label="donate button">
    <script is:inline type="text/javascript" src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js" data-name="bmc-button" data-slug="YourJamPlug" data-color="#FFDD00" data-emoji=""  data-font="Poppins" data-text="Buy me a coffee" data-outline-color="#000000" data-font-color="#000000" data-coffee-color="#ffffff" ></script>

</div>

<script is:inline>
  function initBMC() {
    // Check if the script is already in the document
    const oldScript = document.querySelector('script[data-name="bmc-button"]');
    
    if (oldScript) {
      // 1. Remove the existing button if it was left over from a previous page
      const existingButton = document.querySelector('.bmc-btn-container');
      if (existingButton) existingButton.remove();

      // 2. Re-insert the script to force the BMC library to run its "init" logic
      const newScript = document.createElement('script');
      
      // Copy all attributes from the old script to the new one
      Array.from(oldScript.attributes).forEach(attr => {
        newScript.setAttribute(attr.name, attr.value);
      });

      // Append to the wrapper
      document.getElementById('bmc-wrapper').appendChild(newScript);
      // Remove the old one to keep the DOM clean
      oldScript.remove();
    }
  }

  // Listen for Astro's View Transition event
  document.addEventListener('astro:page-load', initBMC);
</script>

<style>
  .coffee-container {
    margin-block: 1rem 2rem;
    display: flex;
    justify-content: center;
    justify-self: center;
    transform: scale(0.8);
  }

</style>