---
import "../styles/global.css";
import "../styles/components.css";

import { Image } from "astro:assets";

import lightSwitch from "../assets/YJP/sun-theme-brown.svg";
import darkSwitch from "../assets/YJP/moon-theme-brown.svg";

import upArrow from "/src/assets/YJP/arrowTop-brown.svg"

const base = import.meta.env.BASE_URL;
---

<div id="tool-kit">
    <div class="kit-box">
        <button id="themeToggle" class="button"  aria-label="Toggle theme">
            <span class="srOnly">Light / Dark Theme</span>
            <Image src={lightSwitch} alt="light-dark-switch" height={30} width={30} />
        </button>
    </div>
    
    <div class="kit-space">
        <span> --- </span>
    </div>
     
    <div class="kit-box">
        <button aria-label="Go to page top" id="toTop" type="button" name="To Top" title="Go to top" onclick="scrollTop()" class="button">
            <span class="srOnly">To page top</span>
            <Image src={upArrow} alt="up" class="upArrow" width={30} height={30}>
        </button>
    </div>
</div>

<script>

import "../function/basic.js"


</script>