---
import '../styles/global.css'
import '../styles/components.css'

import { getCollection } from "astro:content";

const bigEvents = await getCollection('events', ({ data }) => {
    return data.status === 'published',
     data.eventType === 'Festival';
});

const now = new Date();
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(now.getDate() - 30);

const { eventName, url, description, area, country,  category, age } = Astro.props;
---

<a href={url} >
    <div>
        <div>
            <p>{eventName}</p>
        </div>
        <div>
            <span>{description}</span>
            { age && <span class="age-tag">{age}</span>}
        </div>
        <div>
            <span>{area}, {country}</span>
            <span>{category}</span>
        </div>
    </div>
</a>