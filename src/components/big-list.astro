---
import '../styles/global.css'
import '../styles/components.css'

const { 
    url, 
    eventName, 
    subheading,
    description, 
    location, 
    dates, 
    age, 
    eventType, 
    category,
    discipline, 
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<span id=`${eventName}-describe` class="srOnly">{description}</span>

<a href={url} aria-label=`${eventName}, happening ${dates}` aria-labelledby=`${eventName}-describe`>
<div>
    <div class="title-line">
        <p>{eventName}</p>
        <p>{subheading}</p>
    </div>
    <div>
        { age && <span class="age-tag">{age}</span>}
        <div>
            <span>{dates}</span>
            <span>{location}</span>
            <span>{category}</span>
        </div>
    </div>
</div>
</a>