---
import { Image } from "astro:assets";
import "../styles/components.css" ; 
import type { CollectionEntry } from "astro:content";

type BlogData = CollectionEntry<'blog'>['data'];
interface Props {
  data: Pick<BlogData,  | 'title' | 'description' | 'coverImage' | 'subtitle' | 'blogCategory' | 'skateDiscipline' >;
  id: string;
}

const { data, id } = Astro.props;


--- 

<li>
    <a href={`/blog/${id}/`} > {data.title}
        <div>
           {data.coverImage && (<Image 
                src={data.coverImage}
                alt={data.title}
                width={250}
                height={260}
                format="webp"
            />)}
        </div>
        <div>
            <h5>{data.title}</h5>
            <span>{data.subtitle}</span>
            <p>{data.description}</p>
            <span>read this post</span>
            <div>{data.blogCategory}</div>
            <div>{data.skateDiscipline}</div>
        </div>
    </a> 
</li>


<style>
    a {
        border: 2px solid var(--main-purple);
        border-radius: 8px;
        padding: 5px;
        width: 250px;

        display: flex;
        flex-direction: column;
    }
</style>