---
import { Image } from "astro:assets";
// Import the images directly
import emailIcon from "../assets/email.png";
import instaIcon from "../assets/instagram.png";
import tiktokIcon from "../assets/tik-tok.png";

---
 
<a href="mailto:skater@yourjamplug.com"  class="socialRound">
    <Image src={emailIcon} alt="Email" width={20} height={20} class="social-bagde" />
</a>
<a href="https://www.instagram.com/yourjamplug.uk" target="_blank" class="socialRound">
    <Image src={instaIcon} alt="Instagram" width={20} height={20} class="social-bagde" />
</a>
<a href="https://www.tiktok.com/@skaters.jam.plug" target="_blank" class="socialRound">
    <Image src={tiktokIcon} alt="TikTok" width={20} height={20} class="social-bagde" />
    
</a>

<style>
    .socialRound {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: var(--main-orange);
    }

    .social-badge {
        width: 20px;
        height: 20px;
        
    }
    
    a{
        align-content: center;
        justify-content: center;
        padding: .5ch;
        margin: .5ch;
    }
</style>