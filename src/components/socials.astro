---
import { Image } from "astro:assets";
import { OFFICIAL_LINKS } from "src/data/site-config";
// Import the images directly
import emailIcon from "../assets/email.png";
import instaIcon from "../assets/instagram.png";
import tiktokIcon from "../assets/tik-tok.png";

const base = import.meta.env.BASE_URL;
---
 
<a href={`mailto:${OFFICIAL_LINKS.emailHello}`}  class="socialRound">
    <Image src={emailIcon} alt="Email" width={25} height={25} class="social-bagde" />
</a>
<a href={OFFICIAL_LINKS.instagram} target="_blank" class="socialRound">
    <Image src={instaIcon} alt="Instagram" width={25} height={25} class="social-bagde" />
</a>
<a href={OFFICIAL_LINKS.tiktok} target="_blank" class="socialRound">
    <Image src={tiktokIcon} alt="TikTok" width={25} height={25} class="social-bagde" />
    
</a>

<style>
    .socialRound {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: var(--main-orange);
        display: flex;
        align-items: center;

        transition: background-color 0.2s ease;
    }


    .social-badge {
        width: 20px;
        height: 20px;
        justify-self: center;
        
    }
    
    a{
        align-content: center;
        justify-content: center;
        padding: .5ch;
        margin: .5ch;
    }
</style>