---
import {SITE_TITLE, SITE_DESCRIPTION} from "../data/site-config";
import type { SerializedEvent } from "../function/types";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	Index?: string;
	SEO?: string;
	frontmatter?: SerializedEvent['data'];
}

const { 
  title, 
  description = SITE_DESCRIPTION,
  image = "/content/rolling.png", 
  SEO, 
  Index,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const displayTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href={`${base}/admin/new-favicon.svg`} />
<link rel="canonical" href={canonicalURL} />

<title>{displayTitle}</title>
<meta name="title" content={displayTitle} />
<meta name="description" content={description} />
{SEO && <meta name="SEO" content={SEO} />}
{Index && <meta name="robots" content={Index} />}

<link rel="sitemap" href="/sitemap-index.xml" />

<!-- 
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/> -->

<!-- Web analytics -->
<!-- <script data-goatcounter="https://my-account.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script> -->

<!-- Open Graph tags -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={displayTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={displayTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={displayTitle} />
<meta property="og:description" content={description} />
<!-- <meta property="og:image" content={new URL(image.src, Astro.url)} /> -->

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/RedRose-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
<link rel="preload" href="/fonts/RedRose-VariableFont_wght.woff2" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/ShantellSans-VariableFont.ttf" as="font" type="font/ttf" crossorigin />
<link rel="preload" href="/fonts/fonts/TitanOne-Regular.ttf" as="font" type="font/ttf" crossorigin />
<link rel="preload" href="/fonts/fonts/TitanOne-Regular.woff2" as="font" type="font/woff2" crossorigin />
