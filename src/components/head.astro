---
import {SITE_TITLE, SHORT_TITLE, SITE_DESCRIPTION} from "../data/site-config";
import type { SerializedEvent } from "../function/types";

interface Props {
	title?: string;
	description?: string;
	image?: any;
	Index?: string;
	SEO?: string;
	frontmatter?: SerializedEvent['data'];
}

const { 
  title,  
  description = SITE_DESCRIPTION,
  image, 
  SEO, 
  Index,
} = Astro.props;

import NavIcon from '@admin/new-favicon.svg';
import ogBackup from '@admin/open-graph-backup.jpg'

const finalOgImage = typeof image === 'string' 
  ? image 
  : image?.src || ogBackup.src;

const socialImageURL = new URL(finalOgImage, Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const displayTitle = title ? `${title} | ${SHORT_TITLE}` : SITE_TITLE;

const base = import.meta.env.BASE_URL;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#fff9ed" />

<link rel="icon" type="image/svg+xml" href={NavIcon.src} />
<link rel="canonical" href={canonicalURL} />

<title>{displayTitle}</title>
<meta name="title" content={displayTitle} />
<meta name="description" content={description} />
{SEO && <meta name="SEO" content={SEO} />}
{Index && <meta name="robots" content={Index} />}

<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Web analytics -->
<!-- <script data-goatcounter="https://my-account.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script> -->

<!-- Open Graph tags -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={displayTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:alt" content="Your Jam Plug UK - Retro orange skate graphic for the global skate event directory." />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={displayTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/RedRose-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
<link rel="preload" href="/fonts/RedRose-VariableFont_wght.woff2" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/fonts/TitanOne-Regular.ttf" as="font" type="font/ttf" crossorigin />
<link rel="preload" href="/fonts/fonts/TitanOne-Regular.woff2" as="font" type="font/woff2" crossorigin />

<!-- favicon stuff -->
 <link rel="icon" type="image/png" href="/https://www.yourjamplug.uk/admin/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/https://www.yourjamplug.uk/admin/favicon.svg" />
<link rel="shortcut icon" href="/https://www.yourjamplug.uk/admin/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/https://www.yourjamplug.uk/admin/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="YourJamPlug" />
<link rel="manifest" href="/https://www.yourjamplug.uk/admin/site.webmanifest" />