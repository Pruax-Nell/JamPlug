---
import { Image, Picture } from "astro:assets";
import HeroImg from "../assets/layout/image9.jpg"

const base = import.meta.env.BASE_URL;
---  

<div class="hero-seat">

    <Image 
        src={HeroImg} 
        alt="Skate Jam Hero" 
        width={1200}
        height={600}
        loading="eager" 
        fetchpriority="high"
        class="hero-bg-image" 
    />
    
    <div class="hero-overlay">
        <div class="hero-box">
            <h1 class="welcome">Your Jam Plug</h1>
            <p class="welcome-sub">For Skaters</p>
        </div>
    </div>
</div>

<style>

    .hero-seat {
        position: relative;
        min-height: 20rem;
        width: 100%;
        height: 100%; 
    }

    .hero-bg-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover; 
        object-position: bottom;
        z-index: 1;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: linear-gradient(
            to bottom, 
            rgba(0,0,0,0.4), 
            /* transparent,  */
            var(--shadow-purple-3)
        );
        display: flex;
        align-items: center;
        justify-content: center;

        width: 100%;
        backdrop-filter: blur(.1rem);
    }

    .hero-box{
        display: flex;
        flex-direction: column;
        max-width: max-content;
        width: 100%;
        height: 100%;
        justify-content: end;

        padding-block: 4rem;

    }


    .welcome {
        font-family: var(--font-rose-body);
        font-size: var(--fs-hero);
        font-size: var(--fs-title);
        text-transform: uppercase;
        grid-row: 4/5;
        grid-column: 2 / -2;
        max-width: 100%;
        text-align: center; 
        z-index: 5;
        color: var(--text-white);
        color: var(--second-orange);
        text-shadow: 
        4px 4px 7px var(--ob-brown), 
        2px 2px 6px var(--ow-brown), 
        0 0 .3rem var(--ob-orange);
    }
    
    .welcome-sub{
        font-family: var(--font-rose-body);
        font-size: var(--fs-heading-small);
        text-transform: uppercase;
        margin: .1rem;
        max-width: 100%;
        text-align: left; 
        padding-left: 2rem;
        z-index: 5;
        color: var(--text-white);
        color: var(--second-orange);
        text-shadow: 
        4px 4px 7px var(--ob-brown), 
        2px 2px 6px var(--ow-brown), 
        0 0 .3rem var(--ob-orange);

    }

    @media (max-width: 380px) {
        .welcome-sub {
            padding-left: 0;
            text-align: center;
        }
    }


</style>