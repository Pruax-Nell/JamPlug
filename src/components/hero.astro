---
import { Image, Picture } from "astro:assets";
import HeroImg from "../assets/layout/image9.jpg"


---  

<div class="hero-seat">
    <div class="hero-box">
        <h1 class="welcome"> Your Jam Plug  </h1>
        <!-- <Image class="hero-item" src={HeroImg} priority alt="Skater Welcome" layout='full-width' width={680}/> -->
    </div>
</div>

<style>
    .hero-seat {
        width: 1fr;
        height: 60svh;
        /* height: max-content; */
        background-image: 
        linear-gradient(var(--shadow-brown-2), var(--shadow-brown-2), var(--shadow-orange-3)),
        url("../assets/layout/image9.jpg");
        background-size: 200%;
        background-position: bottom center;
        /* backdrop-filter: blur(.1rem); */
    }

    .hero-box{display: grid;
        grid-template-columns: 5% repeat(5, 18%) 5%;
        grid-template-rows: .5fr repeat(3, 1fr) .2fr;
        height: 100%;
        width: 100%;

        backdrop-filter: blur(.1rem);
    }

    .welcome {
        font-family: var(--font-rose-body);
        text-transform: uppercase;
        /* font-family: var(--font-shantell-notes); */
        grid-row: 5/6;
        grid-column: 1 / 5;
        margin: .1ch;
        text-align: center; 
        font-size: var(--fs-heading-large);
        z-index: 5;
        text-wrap: nowrap;
        color: var(--ob-brown);
        text-shadow: 
            4px 4px 7px var(--ow-brown), 
            0 0 .3rem var(--ob-orange);
        /* -webkit-text-stroke: .02px var(--shadow-brown); */
        /* -webkit-text-stroke: .02px var(--ob-brown); */

    }

    .hero-item{
        width: 100%;
    }

</style>