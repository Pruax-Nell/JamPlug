    if (document.referrer.includes(window.location.host)) {
      history.back();
    } else {
      window.location.href = '/events';
    }
  });
</script> -->

<style>
/* TODO--- */
.calendar-download-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px;
  background-color: #222; /* Neutral dark for generic/Apple feel */
  color: white;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 500;
  transition: background 0.2s;
  font-family: var(--font-rose-body);
}

.calendar-download-btn:hover {
  background-color: #444;
}

  .calendar-section {
    margin-top: 3rem;
    padding: 2rem;
    background: #f8f9fa;
    border-radius: 12px;
    border: 1px solid #eee;
  }

  .calendar-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* Style these to match your site's buttons */
  .button-google, .button-ics {
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: transform 0.2s;
  }

  .button-google {
    background: #4285F4;
    color: white;
  }

  .button-ics {
    background: #000;
    color: white;
  }

  .button-google:hover, .button-ics:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .calendar-buttons {
      flex-direction: column;
    }
  }

/* --- LAYOUT --- */
.poster-frame{
  grid-row: 1 / 2;
}

article header {
  grid-row: 1 / 2;
  grid-column: 2 / 3;
}

.content-body {
  grid-row: 2 / 3;
  grid-column: span 2;
}

.event-gallery-section{
  grid-row: 3 / 4;
  grid-column: span 2;
}

hr {
  grid-row: 3 / 4;
  grid-column: 1 / 2;
}
/* mobile */
@media (max-width: 671px) {

  .poster-frame{
    grid-row: 2 / 3;
    grid-column: span 2;
  }
  
  article header {
    grid-row: 1 / 2;
    grid-column: span 2;
    /* grid-column: 1 / 2; */

  }

  hr {
    grid-row: 3 / 4;
    grid-column: 1 / 2;
  }

  .content-body {
    grid-row: 4 / 5;
    grid-column: 1 / 2;
  }

  .event-gallery-section {
    grid-row: 5 / 6;
    grid-column: 1 / 2;

  }

}

.placeholder-poster{
    aspect-ratio: 4 / 5;
    width: 100%;
    background-color: var(--shadow-orange);
    border-radius: 8px;
}

.event-header-info{
  padding: 1rem .2rem;
}

.event-header-info .sub-heading{
  font-size: var(--fs-p2);
  justify-self: center;
  align-content: center;
}

.age-tag{
    border: 5px double var(--main-pink);
    border-radius: 8px;
    width: max-content;
    padding: .3rem .5rem ;
    margin: .3rem;
    background-color: var(--shadow-pink);
}

.age-tag span {
    font-weight: 400;

}
  
/* --- Shell --- */
  .event-focus {
    display: grid;
    grid-template-rows: auto;
    grid-template-columns: auto-fit auto-fit;
    gap: 10px 25px;
    /* flex-direction: column; */
    max-width: 1200px;
    height: auto;
    margin: 0 auto 2rem auto;
    padding: 0 1rem;
  }
  
  @media (max-width: 671px){
    .event-focus{
      grid-template-columns: 1fr;
      gap: 10px 0;
      
    }
  
  }
  
  
  /* --- Header Section --- */
  article header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 1.8rem auto .5rem auto;
  }

  .cover-image {
    width: 100%;
    height: auto;
    max-width: 350px;
    border-radius: 12px;
    box-shadow: 0 10px 15px -3px var(--shadow-grey-2);
  }

  @media (max-width: 671px){
    .cover-image{
      max-width: 340px;
      aspect-ratio: 4 / 5;
    }
  }

  .poster-frame{
    display: inline-block;
    flex: 0 0 350px;
    height: auto;
  }

 
  hr {
    grid-column: span 2;
    border: 0;
    border-top: 1px solid var(--grey);
    margin: 2rem 0;
    width: 100%;
    clear: both; /* Ensure it sits below the header */
  }

 
  /* --- Typography & Info --- */

  .event-title{
    margin: .8rem 0;
    font-size: var(--fs-heading-xl);
    text-wrap: balance;
  }
  .time-location {
    font-size: 1rem;
    color: var(--ob-purple); /* Indigo accent */
    margin-bottom: 1rem;
  }

  .strong-date {
    font-size: 1.29rem;
  }

  .description-snippet {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--grey);
    margin-bottom: 1.5rem;
  }

  /* --- Pills / Tags --- */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .event-type-label {
  background: var(--main-orange);
  color: var(--black);
  padding: 0.3rem 0.6rem;
  border-radius: 3px 8px 8px 8px;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
}

.discipline {
  background-color: var(--main-yellow);
  padding: .3rem .6rem;
  border-radius: 3px 8px 8px 8px;
  color: var(--main-black);

  font-size: 0.875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

.level {
  background-color: var(--second-purple);
  padding: .3rem .6rem;
  border-radius: 3px 8px 8px 8px;
  color: var(--main-light);

  font-size: 0.875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

  /* --- Main Body Content --- */
  .content-body {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--black);
    margin: 1.8rem 0;
    max-width: 65ch;
  }

  .content-body :global(h4), .content-body :global(h4) {
    margin-top: 2rem;
    margin-bottom: .5rem;
    color: var(--main-purple);
  }

  .content-body :global(p) {
    margin-bottom: 1.5rem;
  }

  /* --- LINEUP Section --- */

  .lineup-container{
    max-width: 100%;
    /* overflow-x: clip; */
  }

.people-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
}

.person-item {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.person-item > * {
 max-width: max-content;
}

.lineup-container h4 {
  font-size: var(--fs-heading-small);
  color: var(--mid-brown);
}

.social-links {
  list-style: none;
  padding: 0;
  /* display: flex; */
  gap: 0.5rem;
}

.social-links a {
  font-size: 0.75rem;
  /* background: var(--shadow-yellow); */
  padding: 2px 8px;
  border-radius: 4px;
  text-decoration: none;
  color: var(--grey);
  text-transform: capitalize;
}

.social-links a:hover {
  background: var(--ow-orange);
}

/* --- Gallery Section --- */

  .event-gallery-section {
    

    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
  }

  .gallery-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: .5rem;
    padding-bottom: 1rem;
    scrollbar-width: 0;
    -webkit-overflow-scrolling: touch;
  }

  .gallery-grid::-webkit-scrollbar { display: none; }

  .gallery-item {
    flex: 0 0 50%; 
    scroll-snap-align: center;
  }
  
  .event-image {
    width: 100%;
    max-width: 350px;
    height: auto;
    aspect-ratio: 4 / 5; 
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px var(--main-purple);
  }



  .gallery-thumb:hover, .event-image:hover {
    transform: scale(1.02);
    transition: transform 0.2s ease-in-out;
    /* cursor: pointer; */
  }



  /* --- Controls --- */
  .navigation-controls {
    margin: 2rem;
  }

@media (max-width: 330px){

  .event-focus{
    /* grid-template-columns: 1fr; */
    display: flex;
    flex-direction: column;

  }

  .event-header-info, .poster-frame{
    max-width: 300px;
  }

  .cover-image{
    aspect-ratio: 1 / 1;
    max-width: 250px;

  }

  .people-list, .person-item, .social-links{
    max-width: 250px;
    overflow-x: hidden;
  }
  

  .social-links a {
    font-size: var(--fs-footer);
    text-wrap: wrap;
    overflow-wrap: wrap;
  }

  .event-image{
    max-width: 200px;
    aspect-ratio: 1 / 1;
  }
}

</style>