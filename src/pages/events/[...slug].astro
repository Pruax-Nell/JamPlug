---
import BaseLayout from '../../layouts/baseLayout.astro';
import '../../styles/components.css'

import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../../components/button.astro';
import { formatEventDate, formatTime, generateCalendarLink } from '../../function/dateHelper';
import { getCalendarUrls } from "../../function/calendarHelper";

export async function getStaticPaths() {
  const posts = await getCollection('events');
  return posts.map((post: CollectionEntry<'events'>) => ({
    params: { slug: post.id }, 
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'events'>;
  // event: any; 
  // children?: any; 
}

const { post } = Astro.props; 
const { data } = post;
const { Content } = await render(post);
// const calendarUrl = generateCalendarLink(event);
const galleryImages = [data.flyerImage1, data.flyerImage2, data.flyerImage3, data.flyerImage4, data.flyerImage5].filter(Boolean);

// HELPERS----
const lineup = [
  { title: "Organisers", people: data.organisers },
  { title: "DJs", people: data.djs },
  { title: "Coaches", people: data.coaches },
  { title: "Hosts", people: data.hosts }
];
const eventDateString = formatEventDate(data.startDate, data.endDate);
const eventStartTime = formatTime(data.startTime);
const eventEndTime = data.endTime ? formatTime(data.endTime) : null;

console.log('FULL POST DATA:', JSON.stringify(post.data, null, 2));
const ogImage = post.data.eventPoster ? post.data.eventPoster.src : '/default-og-image.jpg';
// TODO set default image
const { googleUrl, icsDataUri } = getCalendarUrls(data);
---

<BaseLayout 
  title={`${post.data.eventName} | Your Jam Plug UK`}
  description={post.data.description}
  image={ogImage} 
  image={post.data.eventPoster?.src} 
>
  <nav class="navigation-controls">
    
		<Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/events'"> ← Back to Events </Button>

  </nav>

  <article class="event-focus">
      <div class=" poster-frame">
        {data.eventPoster ? (
        <Image 
          src={data.eventPoster} 
          alt={`Event Poster TBD ${data.eventName}`} 
          width={350} 
          height={510} 
          class="cover-image"
        />
      ) : (
        // TODO create alt event poster
        <div class="placeholder-poster ">🛼</div>
      )}
      </div>

    <header>
      <div class="event-header-info">
        <h4 class="event-title">{data.eventName.toLocaleUpperCase()}</h4>
        <div class="sub-heading">
          {data.subheading && (
            <span>{data.subheading}</span>
          )}
        </div>

        {data.minAge && (
          <div class="age-tag">
          {data.minAge && (
            <span >{data.minAge}</span>
          )}
          {data.maxAge && (
            <span>{data.maxAge}</span>
          )}
        </div>
        )}

        <p class="time-location">
          <strong class="strong-date">{eventDateString}</strong> 
          • {eventStartTime} 
          {eventEndTime && ` - ${eventEndTime}`}
        </p>
          
        <p class="description-snippet">{data.description}</p>
        
        <p> 📍{data.townCity}, {data.location.discriminant.toLocaleUpperCase()}</p>

        <div class="small-space">
          {data.rink && (<span> {data.rink}</span>)}
          {data.venueAddress && (<span> {data.venueAddress}</span>)}
        </div>
        
        <div class="tags"> 
          <span class="event-type-label">{data.eventType}</span>
          <span class="discipline">{data.skateDiscipline}</span>
          {data.skillLevel && (<span class="level"> {data.skillLevel} </span>) }
          {data.offSkates===true && (<span> Non-Skating </span>) }
        </div>
      </div>
    </header>

    <div class="content-body">
<div class="calendar-section">
      <h3>Plan your trip</h3>
      <p>Add this event to your personal calendar so you don't miss a beat.</p>
      
      <div class="calendar-buttons">
        <a href={googleUrl} target="_blank" class="button-google">
          Add to Google Calendar
        </a>
        
        <a href={icsDataUri} download={`${data.eventName}.ics`} class="button-ics">
          Add to Apple / Outlook
        </a>
      </div>

      <a 
  href={icsDataUri} 
  download={`${data.eventName.replace(/\s+/g, '_')}.ics`} 
  class="calendar-download-btn"
>
  <span class="icon">📅</span> Add to Calendar (Apple/Outlook/Mobile)
</a>
    </div>
      <Content />
      
      <div>
          {data.organisers && ( 
          <p>Official page for
          <Button  variant="outline" size="md" href={data.eventLink}> {data.eventName} </Button>
          </p>)}
        
        {data.ticketLink && (
          <Button href={data.ticketLink} variant='outline' size='sm' > Buy tickets here</Button>
        )}

      </div>

      <div>
        <h3>More Event Details:</h3>
        <section class="lineup-container">
          {lineup.map((group) => (
          /* 1. Only render the section if the group exists and has people */
          group.people && group.people.length > 0 && (
            <div class={`group-${group.title.toLowerCase()}`}>
              <h4>{group.title}</h4>
              
              <ul class="people-list">
                {group.people.map((person) => (
                  <li class="person-item">
                    <strong>{person.name}</strong>

                    {/* 2. Only render the sub-list if the person has links */}
                    {person.socialLinks && person.socialLinks.length > 0 && (
                      <ul class="social-links">
                        {person.socialLinks.map((link) => (
                          <li>{link.platform}
                            <a href={link.url} target="_blank" rel="noopener">
                              {link.url?.slice(8, 35)}...Click Here
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        ))}
      </section>
      </div>
    </div>

    {galleryImages.length > 0 && (
      <section class="event-gallery-section">
        <div class="gallery-grid">
          {galleryImages.map((img, index) => (
            <div class="gallery-item">
              <Image 
                src={img!} 
                alt={`${data.eventName} gallery image ${index + 1}`} 
                width={200} 
                height={350}
                class="event-image"
              />
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
  <nav class="navigation-controls">
    
		<Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/events'"> ← Back to Events </Button>

  </nav>
</BaseLayout>

