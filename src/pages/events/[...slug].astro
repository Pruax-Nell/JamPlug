<style>
  /* --- Layout Shell --- */
  .event-focus {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  /* --- Header Section --- */
  header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    header {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .cover-image {
    width: 100%;
    max-width: 350px;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .event-header-info {
    flex: 1;
  }

  /* --- Typography & Info --- */
  .time-location {
    font-size: 1.1rem;
    color: #4f46e5; /* Indigo accent */
    margin-bottom: 1rem;
  }

  .description-snippet {
    font-size: 1.25rem;
    line-height: 1.6;
    color: #374151;
    margin-bottom: 1.5rem;
  }

  /* --- Pills / Tags --- */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags span {
    background: #f3f4f6;
    color: #4b5563;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  /* --- Main Body Content --- */
  .content-body {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #1f2937;
    margin: 3rem 0;
  }

  /* --- Gallery Section --- */
  .gallery-section {
    border-top: 1px solid #e5e7eb;
    padding-top: 3rem;
    margin-top: 3rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .gallery-thumb {
    width: 100%;
    aspect-ratio: 1 / 1; /* Makes them consistent squares */
    object-fit: cover;
    border-radius: 12px;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s;
    cursor: zoom-in;
  }

  .gallery-thumb:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  /* --- Controls --- */
  .navigation-controls {
    margin-bottom: 2rem;
  }
</style>