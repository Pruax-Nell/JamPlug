---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/baseLayout.astro';
import { Image } from 'astro:assets';

import '../styles/event.css'
import '../styles/components.css'

export async function getStaticPaths() {
  const posts = await getCollection('events');
  return posts.map((post: CollectionEntry<'events'>) => ({
    params: { slug: post.id }, 
    props: { post },
  }));
};


interface Props {
  post: CollectionEntry<'events'>;
  // event: any; 
  // children?: any; 
}

const { post } = Astro.props;
const { data } = post;
// const { data } = event;
const { Content } = await render(post);

// HELPERS----
function formatTime(timeObj: any) {
  if (!timeObj || typeof timeObj !== 'object') return '';
  const { hour, minute } = timeObj;
  
  const h = parseInt(hour);
  const ampm = h >= 12 ? 'PM' : 'AM';
  const displayHour = h % 12 || 12;
  
  return `${displayHour}:${minute.toString().padStart(2, '0')} ${ampm}`;
}

const displayDate = new Date(data.startDate).toLocaleDateString('en-GB', {
  weekday: 'short', day: 'numeric', month: 'long'
});

