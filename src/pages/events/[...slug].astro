--- 
import '../../styles/components.css'
import BaseLayout from '../../layouts/baseLayout.astro';

import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import LocationDisplay from '../../components/locationDisplay.astro'
import Button from '../../components/button.astro';

import { formatEventDate, formatTime, getCalendarUrls } from '../../function/dateHelper';
import { formatLocation } from '../../data/globe-constants';

import { mapEventToCard, mapToFeaturedCard, mapEventFull } from '../../function/mapEvents';
import {  mapBlogToCard, mapBlogFull } from '../../function/mapPosts';


export async function getStaticPaths() {

  const posts = await getCollection('events');
  return posts.map((post: CollectionEntry<'events'>) => ({
    params: { slug: post.id }, 
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'events'>;
}

const { post } = Astro.props; 
const { Content } = await render(post);

const event = mapEventFull(post);
const { googleUrl, icsDataUri} = getCalendarUrls(post.data);

// HELPERS----
const lineup = [
  { role: "Organisers", people: event.organisers },
  { role: "DJs", people: event.djs },
  { role: "Coaches", people: event.coaches },
  { role: "Hosts", people: event.hosts },
  { role: "Partners", people: event.partners }
];

console.log('FULL POST DATA:', JSON.stringify(post.data, null, 2));

const ogImage = post.data.eventPoster?.src;
const title = post.data.eventName;

const base = import.meta.env.BASE_URL;
--- 

<BaseLayout 
  title={title}
  description={`Join us in ${event.townCity} for ${title}!`}
  image={ogImage} 
>

<nav class="navigation-controls-top">
<Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/events'" aria-label="To Previous Page"> ← Previous Page </Button>
</nav>

<article class="event-focus frame-fence">

  <section class="event-summary-section">

    <div class=" poster-frame">
     <Image 
      src={event.poster} 
      alt={event.alt} 
      width={350} 
      height={510} 
      class="cover-image"
      />
    </div>
      
    <header class="event-summary">
      <hgroup class="event-header-info">
        <h4 class="event-title">{event.title.toLocaleUpperCase()}</h4>
        <div class="sub-heading">
          {event.subtitle && (
            <span>{event.subtitle}</span>
          )}
      </hgroup>
      
      {event.minAge && (
      <div class="age-tag">
        {event.minAge && (
          <span >{event.minAge}+</span>
        )}
        {event.maxAge && (
          <span>{event.maxAge}</span>
        )}
      </div>
      )}

      <p class="time-location">
        <strong class="strong-date">{event.dateLabel}</strong> 
        {event.startTime} 
        
        {event.endTime && ` - ${event.endTime}`}
      </p>

      <p class="description-snippet">{event.description}</p>

       <p>📍 {event.locationLabel}</p>

      <div class="rink-feat">
        {event.rink && (<span> {event.rink}</span>)}
        
        {event.venueAddress && (<span class="wrap-it"> {event.venueAddress}</span>)}
      </div>

      <div class="tags"> 
        <span class="event-type-label">{event.eventType}</span>
        <span class="discipline">{event.skateDiscipline}</span>
        {event.skillLevel && (<span class="level"> {event.skillLevel} </span>) }
        {event.footwear && (<span class={`${event.footwear}-required`}> {event.footwear} </span>) }
      </div>

    </header>
  </section>

  <section class="event-content-section">
    <div class="event-content">
      <Content />
    </div>

    <hr>

    <div class="ticket-block">
      <hgroup>
        <h3 >Official Links for {event.title}</h3>
      </hgroup>

    {event.organisers && ( 
      <div>
        <p>Official Page:</p>
      <Button  variant="primary" size="lg" theme='orangeDark' href={event.eventLink} target="_blank" aria-label="Official Event Page (external)"> {event.title} </Button>
      </div>)}
    
      <div class="ticket-list">
        <h4>Ticket Links <span class="disclaimer-text">External Sites*</span></h4> 
        
        {event.tickets?.map((ticket) => (
          ticket.url && (
            <div class="ticket-wrapper"> 
              <Button 
                href={ticket.url} 
                variant='outline' 
                theme='brownLight' 
                size='sm'
                aria-label="Link to ticket platform"
              >
                Head to {ticket.platform} platform
              </Button>
            </div>
          )
        ))}
      </div>
    </div>

  </section>

  <section class="event-lineup-section">
    <h3 class="header-group">Event Lineup:</h3>

    {lineup.map((group) => (
      group.people && group.people.length > 0 && (
      <div class={`group-${group.role.toLowerCase()} line-group`}>
        <h4>{group.role}</h4>
        
        <ul class="people-list">
          {group.people.map((person) => (
            <li class="person-item">
              <strong class="name-item">{person?.name}</strong>

              {person?.socials && person.socials.length > 0 && (
                <ul class="social-links">
                  {person.socials.map((link) => (
                    <li class="list-point">{link.platform}:
                      <a href={link.url} target="_blank" rel="noopener" >
                        {link.displayText}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
        )
      ))}

    <div class="calendar-section">
      <p>Add this event to your personal calendar.</p>
      
      <div class="calendar-buttons">
        <a href={googleUrl} target="_blank" class="calendar-download-btn" aria-label="add to Google Calendar">
          Add to Google Calendar
        </a>
        
        
        <a 
        href={icsDataUri} 
        download={`${event.title.replace(/\s+/g, '_')}.ics`} 
        class="calendar-download-btn" aria-label="Add to calendar"
        >
            Add to Calendar <span class="calendar-note">(Apple/Outlook/Mobile)</span>
        </a>
    </div>
    </div>
  </section>

  <!-- future map section -->
  <!-- <section>
    
{mapCoords && (
  <div id="map" 
    data-lat={mapCoords.latitudeCoord} 
    data-lng={mapCoords.longitudecoord}
   ></div>
 )}
  </section> -->

  {event.gallery.length > 0 && (
  <section class="event-gallery-section">
    <p class="self-center header-group">~ Event Gallery ~</p>
    <div class="gallery-grid">
      {event.gallery.map((img, index) => (
        <div class="gallery-item">
          <Image 
            src={img.src} 
            alt={`${img.alt || event.title} gallery image ${index + 1}`} 
            width={900} 
            height={550}
            class="event-image"
            />
        </div>
      ))}
    </div>
  </section>
  )}

</article>

</BaseLayout>

<script>

  document.getElementById('back-button')?.addEventListener('click', () => {
    if (document.referrer.includes(window.location.host)) {
      history.back();
    } else {
      window.location.href = '/events';
    }
  });
</script>

<style>

  .navigation-controls-top{
    display: flex;
    flex-direction: row-reverse;
  }

  /* UTILS */

  .wrap-it{
    display: flex;
    flex-direction: column;
    text-align: left;
    text-wrap: balance;
    
  }

.navigation-controls {
  margin: 1.5rem 3rem;
}

.event-focus {
  display: flex;
  flex-direction: column;

  gap: .8rem 1rem;
  max-width: 1200px;
  height: auto;
  margin: 0 auto 2rem auto;
}

.event-focus section {
  margin-block: 1rem;
}

/* || ------------------------------------------ SUMMARY SECTION */

.event-summary-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

@media (max-width: 780px){

  .event-summary-section {
    display: flex;
    flex-direction: column;
  }
}


.placeholder-poster{
  aspect-ratio: 4 / 5;
  width: 100%;
  background-color: var(--shadow-orange);
  
  border-radius: 8px;
}

.poster-frame{
  grid-row: 1 / 2;
  align-content: center;
}

@media (max-width: 780px) {
  .poster-frame{
    justify-content: center;
    margin-inline: auto;
    display: inline-block;
    flex: 0 0 350px;
    height: auto;
  }

}

.cover-image {
  height: auto;
  max-width: 350px;
  width: 100%;
  border-radius: 12px;
  box-shadow: 0 10px 15px -3px var(--shadow-grey-2);
}

@media (max-width: 780px){

  .cover-image{
    max-width: 340px;
    aspect-ratio: 4 / 5;
  }
}

/* --- summary - Typography & Info --- */

.event-summary {
  grid-row: 1 / 2;
  grid-column: 2 / 3;
  gap: .2rem;

  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

@media (max-width: 780px){
  .event-summary{
    max-width: 80%;
    align-self: center;
    gap: .5rem;
  }

  .event-header-info{
    padding: 0;
  }
}

.event-header-info {
  padding: .2rem;
}

.event-header-info .sub-heading {
  font-size: var(--fs-p2);
  justify-self: center;
  align-content: center;
}

.age-tag {
  border: 5px double var(--main-pink);
  background-color: var(--shadow-pink);
  border-radius: 8px;
  
  width: max-content;
  padding: .3rem .5rem ;
  margin-inline: auto;
}

.event-title{
  margin: .8rem 0;
  font-size: var(--fs-heading-xl);
  text-wrap: balance;
}

.time-location {
  display: flex;
  flex-direction: column;
  margin-bottom: 1rem;
  
  font-size: 1rem;
  color: var(--ob-purple);
}

.strong-date {
  font-size: 1.29rem;
}

.description-snippet {
  max-width: 48ch;
  margin-bottom: .6rem;

  line-height: 1.6;
  font-size: 1.25rem;
  color: var(--grey);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  line-height: 1.8;
}

.rink-feat {
  display: flex;
  gap: .5rem;
  width: 100%;
  justify-content: space-around;
}

.event-type-label {
  background: var(--main-orange);
  color: var(--black);
  padding: 0.3rem 0.6rem;
  border-radius: 3px 8px 8px 8px;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
}

.discipline {
  background-color: var(--main-yellow);
  color: var(--main-black);
  padding: .3rem .6rem;
  border-radius: 3px 8px 8px 8px;

  font-size: 0.875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

.level {
  background-color: var(--second-purple);
  color: var(--main-light);
  padding: .3rem .6rem;
  border-radius: 3px 8px 8px 8px;
  
  font-size: 0.875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

.skates-required{
  border: 3px solid var(--main-purple);
  color: var(--text-black);
  padding: .3rem .6rem;
  border-radius: 10px;
  text-transform: uppercase;
  font-size: 0.775rem;
  letter-spacing: 0.055em;
  border-radius: 3px 8px 8px 8px;
  font-weight: 800;
}

.shoes-required{
  border: 3px solid var(--main-teal);
  color: var(--text-white);
  padding: .3rem .6rem;
  border-radius: 10px;
  text-transform: uppercase;
  font-size: 0.775rem;
  letter-spacing: 0.035em;
  border-radius: 3px 8px 8px 8px;
  font-weight: 800;
}


/* || ----------------------------------------- CONTENT SECTION */

.ticket-block {
  margin-block: 1rem;

}

.ticket-list{
  margin-top: 2rem;
  padding-left: 1rem;
}

.disclaimer-text{
  font-size: var(--fs-caption);
  color: var(--grey);
}

/* || ---------------------------------------- LINEUP Section --- */
hgroup{
  margin-bottom: 1rem;
}
.event-lineup-section{
  max-width: 100%;
}

.line-group {
  margin-block: 2rem;
  padding-left: 10%;
  max-width: 100%;
}

@media (max-width: 480px) {
  .line-group {
    padding-inline-start: 0; 
  }
}

.people-list {
  width: 100%;
  list-style: none;
  padding-inline: 2%;
  padding-top: 3%;
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
}

.person-item {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* .person-item > * {
 max-width: max-content;
} */

.name-item {
  text-decoration: underline;
  text-underline-offset: .4rem;
  text-decoration-color: var(--main-teal);
  max-width: 100%;
}

.event-lineup-section h4 {
  font-size: var(--fs-heading-small);
  color: var(--mid-brown);
}

.social-links {
  max-width: 100%;
  list-style: none;
  padding: 0;
  /* display: flex; */
  gap: 0.5rem;
}

.social-links a {
  display: inline-block;
  max-width: 100%;
  word-break: break-all;
  overflow-wrap: break-word;
  white-space: normal;
  font-size: 0.75rem;
  padding: 2px 8px;
  border-radius: 4px;
  text-decoration: none;
  color: var(--grey);
  text-transform: capitalize;
}

.social-links a:hover {
  background: var(--ow-orange);
}

.list-point {
  margin-block: .5rem;
}

@media (max-width: 330px){
  .event-header-info, .poster-frame{
    max-width: 100%;
  }

  .people-list, .person-item, .social-links{
    overflow-x: hidden;
  }


  .social-links a {
    font-size: var(--fs-footer);
    text-wrap: wrap;
    overflow-wrap: wrap;
  }


}

.calendar-section {
  width: 100%;
  max-width: 20rem;
  margin-block: 1rem;
  padding: 1rem;
  justify-self: center;
  
  border-radius: 12px;
  border: 5px solid var(--mid-teal);
  text-align: center;
}

.calendar-buttons {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  gap: 1rem;
  margin-top: 1.5rem;
}
  
.calendar-download-btn {
  display: flex;
  flex-direction: column;

  align-items: center;
  max-height: 7rem;
  padding: 1rem 1.6rem;
  background-color: #222;
  color: white;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 500;
  font-family: var(--font-rose-body);
  font-size: var(--fs-p3);

  transition: background 0.2s;
}

.calendar-download-btn:hover {
  background-color: #444;
}

.calendar-note{
  font-size: 12px;
}

  @media (max-width: 780px) {
    .calendar-buttons {
      flex-direction: column;
    }
  }



/* || --------------------------------------- Gallery Section --- */

  .event-gallery-section {
    margin-top: 1rem;
    padding-block: 1rem;
    padding-inline: .6rem;
    background-color: var(--shadow-orange);
    border-radius: 12px;
    border-top: 1px solid #eee;
  }

  .gallery-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;

    gap: .8rem;
    padding-bottom: 1rem;
    scrollbar-width: 0;
    -webkit-overflow-scrolling: touch;
  }

  .gallery-grid::-webkit-scrollbar { display: none; }

  .gallery-item {
    flex: 0 0 40%; 
    scroll-snap-align: center;
  }

  @media (max-width: 780px){
    .gallery-item {
      flex: 0 0 90%;

    }
  }
  
  .event-image {
    width: 100%;
    max-width: 350px;
    height: auto;
    aspect-ratio: 4 / 5; 
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px var(--main-purple);
  }

  /* .gallery-thumb:hover, .event-image:hover {
    transform: scale(1.05);
    transition: transform 0.2s ease-in-out;
  } */


@media (max-width: 350px){
  .event-image{
    max-width: 200px;
    aspect-ratio: 1 / 1;
  }
}


</style>