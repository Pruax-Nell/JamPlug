<BaseLayout page_title={data.eventName}>
  <nav class="navigation-controls">
    <button class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/events'">
      ← Back to Events
    </button>
  </nav>

  <article class="event-focus">
    <header>
      <Image 
        src={data.eventPoster} 
        alt={data.eventName} 
        width={350} 
        height={510} 
        class="cover-image"
      />
      
      <div class="event-header-info">
        <p class="time-location">
          <strong>{displayDate}</strong> • {formatTime(data.startTime)} 
          {data.endTime && ` - ${formatTime(data.endTime)}`}
        </p>
        <p class="description-snippet">{data.description}</p>
        
        <div class="tags">
          <span>{data.skateDiscipline}</span>
          <span>{data.eventType}</span>
        </div>
      </div>
    </header>

    <hr />

    <div class="content-body">
      <Content />
    </div>

    {data.gallery && data.gallery.length > 0 && (
      <section class="gallery-section">
        <h3>Gallery</h3>
        <div class="gallery-grid">
          {data.gallery.map((img: any) => (
            <Image src={img} alt="Event gallery image" width={400} height={300} class="gallery-thumb" />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

