--- 
import BaseLayout from '../../layouts/baseLayout.astro';
import '../../styles/components.css'
import LocationDisplay from '../../components/locationDisplay.astro'

import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../../components/button.astro';
import { formatEventDate, formatTime, getCalendarUrls } from '../../function/dateHelper';
import { formatLocation } from '../../data/globe-constants';

export async function getStaticPaths() {
  const posts = await getCollection('events');
  return posts.map((post: CollectionEntry<'events'>) => ({
    params: { slug: post.id }, 
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'events'>;
  // event: any; 
  // children?: any; 
}

const { post } = Astro.props; 
const { data } = post;
const { Content } = await render(post);
const galleryImages = [data.flyerImage1, data.flyerImage2, data.flyerImage3, data.flyerImage4, data.flyerImage5].filter(Boolean);

// HELPERS----
const lineup = [
  { title: "Organisers", people: data.organisers },
  { title: "DJs", people: data.djs },
  { title: "Coaches", people: data.coaches },
  { title: "Hosts", people: data.hosts }
];
const eventDateString = formatEventDate(data.startDate, data.endDate);
const eventStartTime = formatTime(data.startTime);
const eventEndTime = data.endTime ? formatTime(data.endTime) : null;
const eventLocation = formatLocation(post.data.location);
const eventLocString = 

console.log('FULL POST DATA:', JSON.stringify(post.data, null, 2));
const ogImage = post.data.eventPoster ? post.data.eventPoster.src : '/default-og-image.jpg';
const { googleUrl, icsDataUri } = getCalendarUrls(data);
// const locationString = formatLocation(post.data.location.discriminant, post.data.townCity);
const locationString = [post.data.townCity, eventLocation.regionLabel]
  .filter(Boolean)
  .join(', ');

---

<BaseLayout 
  title={post.data.eventName}
  description={`Join us in ${post.data.townCity} for ${post.data.eventName}!`}
  image={ogImage} 
  image={post.data.eventPoster?.src} 
>

<article class="event-focus frame-fence">

  <section class="event-summary-section">

    <div class=" poster-frame">
    {data.eventPoster ? (
      <Image 
      src={data.eventPoster} 
      alt={`Event Poster TBD ${data.eventName}`} 
      width={350} 
      height={510} 
      class="cover-image"
      />
    ) : (
      <div class="placeholder-poster ">🛼</div>
    )}
    </div>
      
    <header class="event-summary">
      <hgroup class="event-header-info">
        <h4 class="event-title">{data.eventName.toLocaleUpperCase()}</h4>
        <div class="sub-heading">
          {data.subheading && (
            <span>{data.subheading}</span>
          )}
      </hgroup>
      
      {data.minAge && (
      <div class="age-tag">
        {data.minAge && (
          <span >{data.minAge}+</span>
        )}
        {data.maxAge && (
          <span>{data.maxAge}</span>
        )}
      </div>
      )}

      <p class="time-location">
        <strong class="strong-date">{eventDateString}</strong> 
        • {eventStartTime} 
        {eventEndTime && ` - ${eventEndTime}`}
      </p>

      <p class="description-snippet">{data.description}</p>

       <p>📍 {locationString}</p>

      <div class="rink-feat">
        {data.rink && (<span> {data.rink}</span>)}
        
        {data.venueAddress && (<span class="wrap-it"> {data.venueAddress}</span>)}
      </div>

      <div class="tags"> 
        <span class="event-type-label">{data.eventType}</span>
        <span class="discipline">{data.skateDiscipline}</span>
        {data.skillLevel && (<span class="level"> {data.skillLevel} </span>) }
        {data.footwear && (<span class={`${data.footwear}-required`}> {data.footwear} </span>) }
      </div>

    </header>
  </section>

  <section class="event-content-section">
    <div class="event-content">
      <Content />
    </div>

    <div class="ticket-block">
    {data.organisers && ( 
      <p>Official page for
      <Button  variant="outline" size="sm" href={data.eventLink}> {data.eventName} </Button>
      </p>)}
    
    {data.ticketLink && (
      <Button href={data.ticketLink} variant='outline' size='sm' > Buy tickets here</Button>
    )}
    </div>

  </section>

  <section class="event-lineup-section">
    <h3 class="header-group">Event Lineup:</h3>

    {lineup.map((group) => (
      group.people && group.people.length > 0 && (
      <div class={`group-${group.title.toLowerCase()} line-group`}>
        <h4>{group.title}</h4>
        
        <ul class="people-list">
          {group.people.map((person) => (
            <li class="person-item">
              <strong class="name-item">{person.name}</strong>

              {person.socialLinks && person.socialLinks.length > 0 && (
                <ul class="social-links">
                  {person.socialLinks.map((link) => (
                    <li class="list-point">{link.platform}:
                      <a href={link.url} target="_blank" rel="noopener" >
                        {link.url?.slice(8, 35)}...Click Here
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
        )
      ))}

    <div class="calendar-section">
      <p>Add this event to your personal calendar.</p>
      
      <div class="calendar-buttons">
        <a href={googleUrl} target="_blank" class="calendar-download-btn">
          Add to Google Calendar
        </a>
        
        
        <a 
        href={icsDataUri} 
        download={`${data.eventName.replace(/\s+/g, '_')}.ics`} 
        class="calendar-download-btn"
        >
            Add to Calendar <span class="calendar-note">(Apple/Outlook/Mobile)</span>
        </a>
    </div>
    </div>
  </section>

  <!-- future map section -->
  <!-- <section>
    
{mapCoords && (
  <div id="map" 
    data-lat={mapCoords.latitudeCoord} 
    data-lng={mapCoords.longitudecoord}
   ></div>
 )}
  </section> -->

  {galleryImages.length > 0 && (
  <section class="event-gallery-section">
    <p class="self-center header-group">~ Scroll the gallery ~</p>
    <div class="gallery-grid">
      {galleryImages.map((img, index) => (
        <div class="gallery-item">
          <Image 
            src={img!} 
            alt={`${data.eventName} gallery image ${index + 1}`} 
            width={200} 
            height={350}
            class="event-image"
            />
        </div>
      ))}
    </div>
  </section>
  )}

</article>

</BaseLayout>

<script>

  document.getElementById('back-button')?.addEventListener('click', () => {
    if (document.referrer.includes(window.location.host)) {
      history.back();
    } else {
      window.location.href = '/events';
    }
  });
</script>

<style>

  /* UTILS */

  .wrap-it{
    display: flex;
    flex-direction: column;
    text-align: left;
    text-wrap: balance;
    
  }

.navigation-controls {
  margin: 1.5rem 3rem;
}

.event-focus {
  display: flex;
  flex-direction: column;

  gap: .8rem 1rem;
  max-width: 1200px;
  height: auto;
  margin: 0 auto 2rem auto;
}

.event-focus section {
  margin-block: 1rem;
}

/* || ------------------------------------------ SUMMARY SECTION */

.event-summary-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

@media (max-width: 780px){

  .event-summary-section {
    display: flex;
    flex-direction: column;
  }
}



.placeholder-poster{
  aspect-ratio: 4 / 5;
  width: 100%;
  background-color: var(--shadow-orange);
  
  border-radius: 8px;
}

.poster-frame{
  grid-row: 1 / 2;
  align-content: center;
}

@media (max-width: 780px) {
  .poster-frame{
    justify-content: center;
    margin-inline: auto;
    display: inline-block;
    flex: 0 0 350px;
    height: auto;
  }

}

.cover-image {
  height: auto;
  max-width: 350px;
  width: 100%;
  border-radius: 12px;
  box-shadow: 0 10px 15px -3px var(--shadow-grey-2);
}

@media (max-width: 780px){

  .cover-image{
    max-width: 340px;
    aspect-ratio: 4 / 5;
  }
}

/* --- summary - Typography & Info --- */

.event-summary {
  grid-row: 1 / 2;
  grid-column: 2 / 3;
  gap: .2rem;

  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

@media (max-width: 780px){
  .event-summary{
    max-width: 80%;
    align-self: center;
    gap: .5rem;
  }

  .event-header-info{
    padding: 0;
  }
}

.event-header-info {
  padding: 1rem .2rem;
}

.event-header-info .sub-heading {
  font-size: var(--fs-p2);
  justify-self: center;
  align-content: center;
}

.age-tag {
  border: 5px double var(--main-pink);
  background-color: var(--shadow-pink);
  border-radius: 8px;
  
  width: max-content;
  padding: .3rem .5rem ;
  margin-inline: auto;
}

.event-title{
  margin: .8rem 0;
  font-size: var(--fs-heading-xl);
  text-wrap: balance;
}

.time-location {
  display: flex;
  flex-direction: column;
  margin-bottom: 1rem;
  
  font-size: 1rem;
  color: var(--ob-purple);
}

.strong-date {
  font-size: 1.29rem;
}

.description-snippet {
  max-width: 48ch;
  margin-bottom: .6rem;

  line-height: 1.6;
  font-size: 1.25rem;
  color: var(--grey);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  line-height: 1.8;
}

.rink-feat {
  display: flex;
  gap: .5rem;
  width: 100%;
  justify-content: space-around;
}

.event-type-label {
  background: var(--main-orange);
  color: var(--black);
  padding: 0.3rem 0.6rem;
  border-radius: 3px 8px 8px 8px;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
}

.discipline {
  background-color: var(--main-yellow);
  color: var(--main-black);
  padding: .3rem .6rem;
  border-radius: 3px 8px 8px 8px;

  font-size: 0.875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

.level {
  background-color: var(--second-purple);
  color: var(--main-light);
  padding: .3rem .6rem;
  border-radius: 3px 8px 8px 8px;
  
  font-size: 0.875rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.035em;
}

.skates-required{
  border: 3px solid var(--main-purple);
  color: var(--text-black);
  padding: .3rem .6rem;
  border-radius: 10px;
  text-transform: uppercase;
  font-size: 0.775rem;
  letter-spacing: 0.055em;
  border-radius: 3px 8px 8px 8px;
  font-weight: 800;
}

.shoes-required{
  border: 3px solid var(--main-teal);
  color: var(--text-white);
  padding: .3rem .6rem;
  border-radius: 10px;
  text-transform: uppercase;
  font-size: 0.775rem;
  letter-spacing: 0.035em;
  border-radius: 3px 8px 8px 8px;
  font-weight: 800;
}


/* || ----------------------------------------- CONTENT SECTION */

.ticket-block {
  margin-block: 1rem;

}

/* || ---------------------------------------- LINEUP Section --- */

.event-lineup-section{
  max-width: 100%;
}

.line-group {
  margin-block: 2rem;
  padding-left: 10%;
  max-width: 100%;
}

@media (max-width: 480px) {
  .line-group {
    padding-inline-start: 0; 
  }
}

.people-list {
  width: 100%;
  list-style: none;
  padding-inline: 2%;
  padding-top: 3%;
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
}

.person-item {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* .person-item > * {
 max-width: max-content;
} */

.name-item {
  text-decoration: underline;
  text-underline-offset: .4rem;
  text-decoration-color: var(--main-teal);
  max-width: 100%;
}

.event-lineup-section h4 {
  font-size: var(--fs-heading-small);
  color: var(--mid-brown);
}

.social-links {
  max-width: 100%;
  list-style: none;
  padding: 0;
  /* display: flex; */
  gap: 0.5rem;
}

.social-links a {
  display: inline-block;
  max-width: 100%;
  word-break: break-all;
  overflow-wrap: break-word;
  white-space: normal;
  font-size: 0.75rem;
  padding: 2px 8px;
  border-radius: 4px;
  text-decoration: none;
  color: var(--grey);
  text-transform: capitalize;
}

.social-links a:hover {
  background: var(--ow-orange);
}

.list-point {
  margin-block: .5rem;
}

@media (max-width: 330px){
  .event-header-info, .poster-frame{
    max-width: 100%;
  }

  .people-list, .person-item, .social-links{
    overflow-x: hidden;
  }


  .social-links a {
    font-size: var(--fs-footer);
    text-wrap: wrap;
    overflow-wrap: wrap;
  }


}

.calendar-section {
  width: 100%;
  max-width: 20rem;
  margin-block: 1rem;
  padding: 1rem;
  justify-self: center;
  
  border-radius: 12px;
  border: 5px solid var(--mid-teal);
  text-align: center;
}

.calendar-buttons {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  gap: 1rem;
  margin-top: 1.5rem;
}
  
.calendar-download-btn {
  display: flex;
  flex-direction: column;

  align-items: center;
  max-height: 7rem;
  padding: 1rem 1.6rem;
  background-color: #222;
  color: white;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 500;
  font-family: var(--font-rose-body);
  font-size: var(--fs-p3);

  transition: background 0.2s;
}

.calendar-download-btn:hover {
  background-color: #444;
}

.calendar-note{
  font-size: 12px;
}

  @media (max-width: 780px) {
    .calendar-buttons {
      flex-direction: column;
    }
  }



/* || --------------------------------------- Gallery Section --- */

  .event-gallery-section {
    margin-top: 1rem;
    padding-block: 1rem;
    padding-inline: .6rem;
    background-color: var(--shadow-orange);
    border-radius: 12px;
    border-top: 1px solid #eee;
  }

  .gallery-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;

    gap: .8rem;
    padding-bottom: 1rem;
    scrollbar-width: 0;
    -webkit-overflow-scrolling: touch;
  }

  .gallery-grid::-webkit-scrollbar { display: none; }

  .gallery-item {
    flex: 0 0 50%; 
    scroll-snap-align: center;
  }

  @media (max-width: 780px){
    .gallery-item {
      flex: 0 0 90%;

    }
  }
  
  .event-image {
    width: 100%;
    max-width: 350px;
    height: auto;
    aspect-ratio: 4 / 5; 
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px var(--main-purple);
  }

  /* .gallery-thumb:hover, .event-image:hover {
    transform: scale(1.05);
    transition: transform 0.2s ease-in-out;
  } */


@media (max-width: 350px){
  .event-image{
    max-width: 200px;
    aspect-ratio: 1 / 1;
  }
}


</style>