---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/blogLayout.astro';
import BaseLayout from '../../layouts/baseLayout.astro';

import Image from 'astro/components/Image.astro';

export async function getStaticPaths() {
  const allOrganisers = await getCollection('organisers');
  return allOrganisers.map(org => ({
    params: { slug: org.id }, 
    props: { org },
  }));
}

const eventsByThisOrg = await getCollection('events', ({ data }) => {
  return data.organiser === org.id;
});
 
const { org } = Astro.props;
const { socials = [] } = org.data;
---

<BaseLayout >
    <div class="top-block">
        {org.data.brand && (<Image src={org.data.brand} alt={org.data.name} width={400} height={320} class='org-logo'/> )}
        <h1>{org.data.name}</h1>
        <p>{org.data.about}</p>
        <div class="">
            {socials.map((link) => (
                <a href={link.url} class={`icon-${link.platform}`}>
                {link.platform}
                </a>
            ))}
        </div>
    </div>

    <div class="bottom-block">
        <span>Related Events</span>
        <div>
            <ul>
                {eventsByThisOrg.map(event => (
                    <li class="event-post"><a href={`/events/${event.id}`}>
                        <div class="mini-poster">
                            {org.data.brand && (<Image src={event.data.eventPoster} alt={event.data.eventName} width={200} height={200} class='mini-image'/>)}
                            <p>{event.data.eventName}</p>
                            <p>{event.data.townCity} - {event.data.country} </p> 
                            <p>{event.data.eventType} - {event.data.category}</p> 
                        </div>
                    </a></li>
                ))}
            </ul>
        </div>
    </div>
    
</BaseLayout>


<style>
    .top-block{
        display: flex;
        flex-direction: column;
        width: 85svw;
        
    } 
    .bottom-block{
        display: flex;
        flex-direction: column;
        width: 85svw;
    } 
    .org-logo{
        
    }
    .event-post{
        border-radius: 8px;
        background-color: var(--main-orange); 
    }
    .mini-poster{
        display: flex;
        flex-direction: column;
        
    }
    
</style>