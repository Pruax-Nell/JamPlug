---

import BaseLayout from '../layouts/baseLayout.astro';
import Button from "../components/button.astro";

import { OFFICIAL_LINKS } from 'src/data/site-config';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Thank You!">
  <section class="thanks-container">
    <h1>Thanks <span id="display-name">skater</span>, we got it!</h1>
    <p>Your contribution to the global skate Map is highly appreciated!</p>
    <Button variant='primary' theme='brownLight' size='md' href='/events' aria-label="Back to Events Page">Back to Events</Button>
  </section>

  <section class="privacy-transparency-box">
    <h3>Your Data & Privacy</h3>
    <ul>

      <li><strong>Storage:</strong> Your data is hosted on secure Swiss servers (Infomaniak) and backed up to our local encrypted drive.</li>
      <li><strong>Usage:</strong> We only use this info to list your event/business on this site.</li>
      <li><strong>Usage:</strong> If you signed up for our Global Network, your contact details are used to send B2B correspondence.</li>
      <li> <strong>Your Rights:</strong> Want to change or delete your listing? Just email <a href={`mailto:${OFFICIAL_LINKS.emailHello}`}>{OFFICIAL_LINKS.emailHello}</a> and upon receipt we'll wipe it from our servers and SSD within 48 hours. </li>

    </ul>
  </section>
  <nav>
    <h3>Where Next?</h3>
    <p>Head to:</p>
    <Button variant='primary' theme='brownLight' size='md' href='/events/' >Current Events</Button>
    <Button variant='primary' theme='brownLight' size='md' href='/directory/' >UK Directory</Button>
    <Button variant='primary' theme='brownLight' size='md' href='/about/'  >About page</Button>
  </nav>

</BaseLayout>

<script is:inline>
  const urlParams = new URLSearchParams(window.location.search);
  const name = urlParams.get('skaterName');
  const role = urlParams.get('skaterRole');

  if (name) {
    document.getElementById('display-name').innerText = name;
  }

  if (role) {
    document.getElementById('display-role').innerText = role.toLowerCase();
    document.getElementById('role-message').style.display = 'block';
  }
</script>

<style>
  .thanks-container {
    text-align: center;
    padding: 10% 5%;
  }
  h1 { color: var(--special-teal); font-size: 3rem; }
</style>