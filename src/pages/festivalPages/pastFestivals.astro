---
import '../../styles/event.css'
import '../../styles/home.css'

import BaseLayout from "../../layouts/baseLayout.astro";
import BigList from "../../components/big-list.astro";
import CardHolder from "../../components/card-holder.astro";
import {CURRENT_YEAR, getYearRange } from "../../data/site-config";

const { prevYear, currentYear, nextYear } = getYearRange();


import { formatEventDate, formatDate, formatFestivalDate } from '../../function/dateHelper';
import { formatLocation } from '../../data/globe-constants';
import { formatLabel, formatLocationString } from '../../function/stringHelper';

import { getCollection } from "astro:content";

const targetYear = 2026;

const bigEvents = await getCollection('events', ({ data }) => {
    return data.status === 'published' && 
           data.eventType === 'festival' &&
           data.startDate.getFullYear() === prevYear; 
});


const monthOrder = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];

// GENERAL UTILITY
const now = new Date();
now.setHours(0, 0, 0, 0);


const groupedEvents = bigEvents.reduce((acc: Record<string, any[]>, event) => {
    const month = event.data.startDate.toLocaleString(['en-GB', 'en-US'], { month: 'long' });
    
    if (!acc[month]) {
        acc[month] = [];
    }
    
    acc[month].push(event);
    
    return acc;
}, {});

Object.values(groupedEvents).forEach(monthArray => {
    monthArray.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
});

// UPCOMING EVENTS
const publishedEvents = await getCollection('events', ({ data }) => {
  return data.status === 'published';
});

const upcomingEvents = (publishedEvents)
.map(event => ({
	id: event.id,
	title: event.data.eventName,
	poster: event.data.eventPoster,
	city: event.data.townCity,
	country: event.data.location.discriminant,
	description: event.data.description,
	eventType: event.data.eventType,
	featured: event.data.isFeatured,
	timeframe: {
		startDate: new Date(event.data.startDate),
		endDate: event.data.endDate ? new Date(event.data.endDate) : null
	}
	
}))
.sort(
	(a, b) => b.timeframe.startDate.valueOf() - a.timeframe.startDate.valueOf(),
)
.slice(0, 8);

// console.log(bigEvents);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
title="Last year's Big Jam List"
description="Find roller Skate festivals from around the world">
<section class="frame-fence welcome">
    <hgroup>
        <h1>Past Jam List</h1>
        <p>You're looking at skate festivals from </p>
        <span class="stand-out">Last Year!</span>
        <p>Use the button below to view this year's list</p>
    </hgroup>

</section>
</section>
<section class="frame-fence">
    <div class="jam-direct"> 
        <!-- <span><a class="jam-year-button-down jam-year-button"> {prevYear} </a></span> -->
        <h2 class="year-title">{prevYear}</h2>
        <span><a class="jam-year-button-up jam-year-button" href="/festivals"> {currentYear} </a></span>
    </div>
    <div id="jam-list">
        {monthOrder.map((month) => {
            const eventsInMonth = groupedEvents[month] || [];
            
            return (
            <div class="month-block">
                <h2 class="line-month">{month}</h2>

                {eventsInMonth.length > 0 ? (
                    <ul>
                    {eventsInMonth.map((event) => {
                        const loc = formatLocation(event.data.location, event.data.townCity);
                        const dateRange = formatFestivalDate(event.data.startDate, event.data.endDate);
                        
                    return (
                        <li class="jam-item">
                        <a href={`/events/${event.id}/`}>
                            <div class="jam-content">
                                <div class="jam-title">
                                    <p class="line-title ">{event.data.eventName}</p>
                                    <p class="line-subtitle line-small">{event.data.subheading}</p>
                                    <p class="line-description line-small">{event.data.description}</p>
                                </div>

                                <div class="divider"></div>

                                <div class="jam-info">
                                    <p class="line-location line-small">{loc.full}</p>
                                    <p class="line-date line-small">{dateRange}</p>
                                </div>
                            </div>
                        </a>
                        </li>
                    );
                })}
            </ul>
            ) : (
            <p class="no-events">...</p>
            )}
        </div>
        );
    })}
    </div>
</section>
<section class="frame-fence">
    <h4>General Upcoming Events: </h4>
    <!-- <a href="/events" class="tertiary-button"> Browse the event list </a> -->
    {upcomingEvents.length > 0 ? (
				<div class="carosel" role="list" aria-label="Upcoming Events">
			{upcomingEvents.map((post) => (
				<CardHolder 
				variant="event"
				title={post.title}
				url={`/events/${post.id}/`}
				poster={post.poster}
				city={post.city}
				country={post.country}
				timeframe={post.timeframe}
				description={post.description}
                eventType={post.eventType}
				/>
			))}

			<CardHolder 
				variant="placeholder"
				title="See more Events"
				url="/events"
				description="Browse All Events"
			/>
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>no events to show yet</p></div>)}
</section>


</BaseLayout>

<style>
    .welcome {
        justify-items: center;
        min-height: 10rem;
        /* background-color: var(--shadow-orange); */
        border-radius: 0 0 22px 22px;
        padding: .5rem;
        gap: 2rem;
    }

    .welcome hgroup{
        text-align: center;
    }
    
    @media (max-width: 620px){
        .welcome {
            padding-top: 3rem;
        }
    }

    .stand-out{
        font-size: var(--fs-p1);
        color: var(--text-black);
        color: var(--main-brown);
        font-weight: 800;
        padding: .3rem .5rem;
        border-radius: 5px;
        line-height: 2.5;
    }


    
    .jam-req {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: space-around;
        margin-block: 2rem;
        max-width: 65ch;
        
    }
    
    .jam-direct {
        display: flex;
        justify-content: center;
        max-width: 100%;
        gap: 1rem;
        align-content: center;
        padding: .2rem;
        margin-bottom: .5rem;
    }

    .jam-direct span {
        align-content: center;
    }

    /* Festival block */

    #jam-list {
        background-color: var(--shadow-orange-2);
        background-color: var(--shadow-teal-3);
        border-radius: 28px;
        padding: 3rem .8rem;
    }

    /* annual directions */
    .year-title {
        justify-self: center;
        font-size: var(--fs-title);
    }

    .jam-year-button{
        letter-spacing: .3ch;
        padding: .6rem 1rem;
        background-color: var(--ow-orange);

        transition: border 3s ease-in-out;
    }

    .jam-year-button:hover{
        /* background-color: var(--mid-teal); */
        border: 3px solid var(--grey) ;
        /* cursor: default; */
        
    }
    .jam-year-button-up {
        /* opacity: 30%; */
        border-radius: 8px 25px 25px 8px;
        
    }
    .jam-year-button-down {
        /* opacity: 30%; */
        border-radius: 25px 8px 8px 25px;
        
    }

    .divider {
        align-content: center;
        width: .2rem;
    }

  
    .line-month{
        color: var(--text-black);
        padding: .3rem;
        margin-bottom: .1rem;
    }

    .jam-item {
        display: flex;
        flex-direction: row;
        max-width: 100%;
        margin-block: 1rem;
        padding: .2rem;
        border-radius: 8px;
        border-top: 2px solid var(--main-pink);
        background-color: var(--highlight);
        
        transition: box-shadow .3s ease, transform .1s ease-in-out;
    }

    .jam-item a {
       width: 100%;
    }

    .jam-item:hover{
        border: 1.3px solid var(--second-purple);
        box-shadow: 3px 2px 5px var(--main-orange), 5px 3px var(--ow-purple);
        
        transform: translateY(-2px);
    }

    .jam-content {
        display: grid;
        grid-template-columns: auto 10px auto;
        margin: .8rem .4rem;
        padding: 0;
    }

    .jam-title  {
        display: flex;
        flex-direction: column;
        height: max-content;
        max-width: 100%;
        justify-content:space-between;
    }

    
    .line-title{
        font-size: var(--fs-p2);
        color: var(--text-black);
        font-weight: 800;
        padding-bottom: .3rem;
    }
    .line-subtitle{
        color: var(--text-black);
        font-size: var(--fs-p3);
        padding-left: .2rem;
        text-wrap: balance;
        margin-bottom: .8rem;
    }
    
    .line-description{
        font-size: var(--fs-caption);
        color: var(--text-black);
        max-width: 45ch;
        text-wrap: pretty;
        padding-left: .2rem;
    }

    .line-date{
        font-size: var(--fs-caption);
    }

   .line-location{
        font-size: var(--fs-caption);
        text-wrap: balance;
    }

    .jam-info {
        display: flex;
        flex-direction: column;
        max-height: 100%;
        width: 1fr;
    }

    .month-block{
        padding: .7rem;
    }
    .month-block h2 {
        justify-self: left;
        margin-left: 3rem;
        font-size: var(--fs-heading-mid);
    }

    .month-block ul {
        padding-left: 0;
    }

    @media (max-width: 680px){

        .jam-item{
            justify-content: center;
        }

        .jam-content {
            display: flex;
            flex-direction: column;
            padding: .2rem;
            gap: .8rem;

        }

        .line-small{
            padding-left: 1rem;
        }
        .line-small-s{
            /* padding-left: 1rem; */
            text-align: right;
        }
        .jam-info{
            /* padding-left: 1rem; */
            text-align: right;
        }
    }

</style> 