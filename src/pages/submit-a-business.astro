---
import BaseLayout from "../layouts/baseLayout.astro"
import FormBusiness from "../components/form/formBusiness.astro"
import Button from "../components/button.astro";
 
import "../styles/global.css";
import "../styles/submit.css";

---

<BaseLayout> 
    <section class="form-fence">
        <hgroup class="submission-title">
            <h1>Submit your Business</h1>
            <p>retail shop / skate rink / skate brand / manufacturer etc</p>
            <p>use the form below to get your details listed in the global roller skate directory</p>
        </hgroup>
    </section>
        
    <!-- ||------------------------------------- FORM SECTION  -->
    <section class="form-fence">
        <div class="form-wrap">
            <FormBusiness/>
        </div>
    </section>



    <section class="form-fence direct-other">
        <p>Other Options:</p>
        <div class="direction-box">
            <p class="direction-item"><a href="/submit-an-event">Submit an Event</a></p>
            <p class="direction-item"><a href="/enquiry">General Enquiry</a></p>
            <p class="direction-item"><a href="">Join the Newsletter</a></p>
        </div>
    </section>
        
</BaseLayout>