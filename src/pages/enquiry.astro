---
import BaseLayout from "../layouts/baseLayout.astro"

import Button from "../components/button.astro";

import "../styles/global.css";
import "../styles/submit.css";

// event forms
import FormOther from "../components/form/formOther.astro"
import FormNight from "../components/form/formNight.astro"
import FormSocial from "../components/form/formSocial.astro"
import FormWeekend from "../components/form/formWeekend.astro"
import FormWorkshop from "../components/form/formWorkshop.astro"
import FormFestival from "../components/form/formfestival.astro"

const base = import.meta.env.BASE_URL;

---

<BaseLayout
title="Contact Us"
description="Send us a Message"> 
<nav class="navigation-controls">
    <Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/events'"> ← Previous Page </Button>
</nav>

    <section class="form-fence">
        <hgroup class="form-title-group">
            <h2 class="form-title">Talk to Us</h2>
            <p>Submit your message below</p>
        </hgroup>
    </section>

    <!-- ||------------------------------------- FORM SECTION  -->
    <section class="form-fence ">
        <!-- -||----------------------- FORM FIELD  -->
        <!-- <div id="general-form" class=" form-wrap"><FormOther /> </div> -->
        <!-- <div id="workshop-form" class=" form-wrap"> <FormWorkshop /> </div> -->
        <!-- <div id="weekend-form" class=" form-wrap"> <FormWeekend /> </div> -->
        <!-- <div id="social-form" class=" form-wrap"> <FormSocial /> </div> -->
        <!-- <div id="night-form" class=" form-wrap"> <FormNight /> </div> -->
        <!-- <div id="festival-form" class=" form-wrap"> <FormFestival /> </div> -->
        
        <div class="form-wrap">
             <form 
            action="https://submit-form.com/your-id" 
            method="POST" 
            enctype="multipart/form-data"
            >
                <input type="text" name="_honeypot" style="display:none" tabindex="-1" autocomplete="off" />
                <input type="hidden" name="form_category" value="General Enquiry" />
                <div class="form-field">
                    <label for="1name" >First Name</label>
                    <input  type="text" id="1name" placeholder="First Name" name="" required>
                </div>

                <div class="form-field">
                    <label for="2name" >Surname</label>
                    <input  type="text" id="2name" placeholder="Surname" name="" >
                </div>

                <div class="form-field">
                    <label for="3email" >Email:</label>
                    <input  type="text" id="3email" placeholder="YourEmail@Address.co.uk" name="" >
                </div>

                <div class="form-field">
                    <label for="4message" >Your Message:</label>
                    <textarea id="4message" ></textarea>
                </div>
 

                <div class="btn-wrap form-field">
                    <Button variant="tertiary" size="lg" theme="purpleLight" type="submit">Submit Event</Button>
                </div>
            </form>

        </div>
    </section>

    <section class="form-fence direct-other">
        <p>Other Options:</p>
        <div class="direction-box">
            <p class="direction-item"><a href="/submit-an-event">Submit an Event</a></p>
            <p class="direction-item"><a href="/submit-a-business">Submit a Group/Business</a></p>
            <p class="direction-item"><a href="">Join the Newsletter</a></p>
        </div>
    </section>
        
</BaseLayout>