---
import BaseLayout from '../../../layouts/baseLayout.astro';
import Button from '../../../components/button.astro';
import CustomImage from '../../../components/mdoc/customImage.astro';
import { getCollection, render, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import { formatDate } from '../../../function/dateHelper';

// const galleryList = [
//   post.data.gallery1, 
//   post.data.gallery2, 
//   post.data.gallery3, 
//   post.data.gallery4
// ].filter((item): item is NonNullable<typeof item> => !!item);
  
export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts
    .filter((post) => {
      return post.data.status === 'published';
    })
    .map((post: CollectionEntry<'posts'>) => ({
      params: { slug: post.slug }, 
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

const components = {
  CustomImage,
};

const lastEditDate = post.data.updated ? formatDate(post.data.updated) : null;

// const authorSlug = post.data.author.profile;
const authorId = typeof post.data.author.profile === 'object' 
  ? post.data.author.profile.id 
  : post.data.author.profile;

const authorEntry = await getEntry('authors', authorId);

const alias = authorEntry?.data?.alias || "Contributor";


const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={post.data.title} description={post.data.description}>
<nav class="navigation-controls">
  
  <Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/blog'"> ← Previous Page </Button>
  <Button variant='outline' theme='brownLight' size='xs' href='/blog' >To Blog List</Button>

</nav>
<article class="blog-container">
  <header>
    <h1 class="post-header">{post.data.title}</h1>
    <p class="sub-heading">{post.data.subtitle}</p>
    <time datetime={new Date(post.data.published).toISOString()} class="pub-date">
      {new Date(post.data.published).toLocaleDateString(undefined, {
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric'
      })}
    </time>
    
    <p class="lead-text desc">{post.data.description}</p>


  </header>

  
{post.data.coverImage && (  <Image 
    src={post.data.coverImage.src} 
    alt={post.data.title} 
    width={300} 
    // height={250} 
    class="cover-image"
    loading="eager"
  />)}
   <!-- <a href={`/authors/${post.data.author.profile}`}>
   </a>  -->

  <div class="content-body">
    {post.data.author.isAnonymous ? (
      <div class="anon-profile">
        <span class="anon-icon">👤</span>
        <p>Posted by <strong>A Jam Plug Contributor</strong></p>
      </div>
    ) : (
      
      <div>
        <p>Written by: <strong>{alias}</strong> </p>
      </div>
    )}
    
    {post.data.updated && (<p>Last Updated{lastEditDate} </p>)}
    <!-- <Content /> -->
    <Content components={components} />
  </div>

  <!-- {galleryList.length > 0 && (
    <section class="gallery-grid">
        {galleryList.map((item) => (
          <figure class="gallery-item">
            <Image 
              src={item} 
              alt={post.data.title}
              width={450} 
              format="avif"
              class="gallery-post"
            />
          </figure>
        ))} 
    </section>
  )} -->

  {post.data.skateDiscipline && post.data.blogCategory && ( 
      <footer class="post-footer">
          <span class="meta-item dis">{post.data.skateDiscipline}</span>
          <span class="meta-item cat">{post.data.blogCategory}</span>
      </footer>
  )}

</article>

</BaseLayout>


<style>

  .blog-container {
    display: flex;
    flex-direction: column;
    max-width: 900px;
    margin: 1.5rem auto;
    padding-block: .5rem;
    gap: 2rem;
  }

  .pub-date{
    text-align: right;
    justify-self: flex-end;
    font-size: var(--fs-footer);
    letter-spacing: .18ch;
  }
  .cover-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }
  .content-body {
    line-height: 1.8;
    font-size: 1.1rem;
  }

  .post-header, .sub-heading{
    text-transform: capitalize;
  }

  .gallery-grid {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    margin-top: 3rem;
    overflow-x: scroll;
    overflow-y: hidden;
  }

  .gallery-post{}

  .navigation-controls{
    display: flex;
    flex-direction: row;
    gap: 2rem;
    margin-top: 1.3rem;
    padding: .5rem;
    justify-content: right;
    align-items: center;
  }


.post-footer{
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: end;
  gap: 2rem;
}


.desc {
  padding-top: 1.5rem;
    font-size: var(--fs-p3);
    line-height: 1.5;

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3; 
    overflow: hidden;
    text-overflow: ellipsis;
}

footer {
    justify-self: center;
    margin-top: auto;
    align-self: center;
    display: flex;
    gap: 1.5rem;
}

.meta-item {
    border-bottom: 2px solid var(--second-brown);
    background-color: var(--ow-brown);
    border-radius: 8px;
    padding: .5rem .8rem;
    text-transform: uppercase;
    font-size: var(--fs-footer);
}

@media (max-width: 520px){
  .blog-container{
    padding-left: 1rem;

  }
}



</style>
