---
import BaseLayout from '../../../layouts/baseLayout.astro';
import Button from '../../../components/button.astro';
import CustomImage from '../../../components/mdoc/customImage.astro';

import { getCollection, render, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { SerializedAuthor } from '../../../function/types';
import { Image } from 'astro:assets';

import { formatDate } from '../../../function/dateHelper';
import { mapBlogFull } from 'src/function/mapPosts';
// eventually add mapPerson/author

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => post.data.status === 'published')
    .map((post: CollectionEntry<'posts'>) => ({
      params: { slug: post.slug }, 
      props: { post },
    }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const components = { CustomImage };

// grab author data
const authorId = typeof post.data.author.profile === 'object' 
  ? post.data.author.profile.id 
  : post.data.author.profile;
  
const rawAuthorEntry = authorId ? await getEntry('authors', authorId) : null;
const authorEntry = rawAuthorEntry as SerializedAuthor | null;
const alias = authorEntry?.data?.alias || "A Jam Plug Contributor";
const lastEditDate = post.data.updated ? formatDate(post.data.updated) : null;


const blog = mapBlogFull(post);
// const person = mapPerson(post) ??? Check. 
const { Content } = await render(post);

const title = post.data.title;
const description = post.data.description;
const base = import.meta.env.BASE_URL; 

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPost",
  "abstract": blog.description || blog.caption,
  "image": blog.poster,
  "url": "https://yourjamplug.uk",
  "description": blog.description,
  "author": blog.authorID,
  "datePublished": blog.published,
  "dateModified": blog.updated,
  "keywords": "roller skating, roller disco, skate jam, roller skater, skate event"
};

---

<BaseLayout title={title} description={description} schema={blogSchema}>
<nav class="navigation-controls">
  
  <Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/blog'"> ← Previous Page </Button>
  <Button variant='outline' theme='brownLight' size='xs' href='/blog' >To Blog List</Button>

</nav>
<article class="blog-container">

  <header class="page-head-block">
    <h1 class="post-header">{blog.title}</h1>
    <p class="sub-heading">{blog.subtitle}</p>
    <time datetime={new Date(blog.published).toISOString()} class="pub-date">
      {new Date(blog.published).toLocaleDateString(undefined, {
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric'
      })}
    </time>
    <p class="lead-text desc">{blog.description}</p>
  </header>

{console.log('Processing Image for post:', post.slug, 'Data:', blog.poster)}
  {!blog.isPlaceholder && (
    <figure class="cover-image-container">

      <div class="image-block">
        <Image 
          src={blog.poster}
          alt={blog.alt || blog.title} 
          width={1000} 
          class="cover-image"
          loading="eager" 
        />
      </div>
      
      {blog.caption && (
        <figcaption class="cover-caption">
          {blog.caption}
        </figcaption>
      )}
    </figure>
  )}
   
   <section class="author-section">
     {blog.anonymous ? (
       <div class="anon-profile">
        <span class="anon-icon">👤</span>
        <p>Posted by <strong>A Jam Plug Contributor</strong></p>
      </div>
    ) : (
      <div class="author-info">
        <p>Written by: <strong>{blog.authorID}</strong></p>
      </div>
    )}

  <!-- <a href={`/authors/${post.data.author.profile}`}></a>  -->
   </section>

  <section class="content-body">

  
    {blog.updated && (<p class="updated-label">Last Updated: {lastEditDate}</p>)}
    <div class="main-content">
      <Content components={components} />
    </div>
  </section>

  <!-- {galleryList.length > 0 && (
    <section class="gallery-grid">
        {galleryList.map((item) => (
          <figure class="gallery-item">
            <Image 
              src={item} 
              alt={item.alt || post.data.title}
              width={450} 
              format="avif"
              class="gallery-post"
            />
          </figure>
        ))} 
    </section>
  )} -->

  {blog.discipline && blog.category && ( 
      <footer class="post-footer">
          <span class="meta-item dis">{blog.discipline}</span>
          <span class="meta-item cat">{blog.category}</span>
      </footer>
  )}

</article>

</BaseLayout>


<style>

  .blog-container {
    display: flex;
    flex-direction: column;
    max-width: 900px;
    margin: 1.5rem auto;
    padding-block: .5rem;
    gap: 2rem;
  }



  /* ------------------------------------------ HGROUP ---------- */
.page-head-block{
  margin-bottom: 1rem;

}

 .post-header, .sub-heading{
    text-transform: capitalize;
    text-wrap: balance;
    text-align: center;
    justify-self: center;
    margin-block: .5rem;

  }

  .pub-date{
    text-align: right;
    justify-self: flex-end;
    font-size: var(--fs-footer);
    letter-spacing: .18ch;
  }

  .desc {
    padding-top: 1.5rem;
    font-size: var(--fs-p3);
    line-height: 1.5;

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3; 
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ------------------------------------------ IMAGE ---------- */
  .cover-image-container{

  }
  
  .image-block{
    display: flex;
    flex-direction: column;

    aspect-ratio: auto;
    border-radius: 12px;
    height: 25rem;
    overflow: hidden;

    justify-content: center;
    align-items: center;
    
  }
  
  .cover-image {
      /* width: 100%; */
      width: auto;
      height: 100%;
      border-radius: 8px;
      margin: 2rem 0;
      justify-self: center;

      object-fit: cover;
  }

  @media (max-width: 720px){
    .image-block{
      height: 15rem;
    }


  }

  /* ------------------------------------- CONTENT ------------- */
  .content-body {
    line-height: 1.8;
    font-size: 1.1rem;
  }

 

  .main-content{
    font-family: var(--font-body);
    
  }
  .main-content :global(p){
    line-height: 2.5;
    font-family: var(--font-body);
    font-size: var(--fs-p2);
    margin-bottom: 1.2rem;
    
  }
  .main-content :global(li){
    font-size: var(--fs-p3);
    padding-left: .2rem;
    margin-bottom: 1rem;
    line-height: 1.8;
  }
  .main-content :global( h2, h3, h4, h5, h6){
   padding-left: 3rem;
   color: var(--ob-brown);
  }

  .main-content :global(h1){
   
  }

  .gallery-grid {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    margin-top: 3rem;
    overflow-x: scroll;
    overflow-y: hidden;
  }

  .gallery-post{}

  .navigation-controls{
    display: flex;
    flex-direction: row;
    gap: 2rem;
    margin-top: 1.3rem;
    padding: .5rem;
    justify-content: right;
    align-items: center;
  }


.post-footer{
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: end;
  gap: 2rem;
}




footer {
    justify-self: center;
    margin-top: auto;
    align-self: center;
    display: flex;
    gap: 1.5rem;
}

.meta-item {
    border-bottom: 2px solid var(--second-brown);
    background-color: var(--ow-brown);
    border-radius: 8px;
    padding: .5rem .8rem;
    text-transform: uppercase;
    font-size: var(--fs-footer);
}

@media (max-width: 520px){
  .blog-container{
    padding-left: 1rem;

  }
}



</style>
