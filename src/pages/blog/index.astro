---
import BaseLayout from '../../layouts/baseLayout.astro'; 
import BlogCard from '../../components/blogCard.astro';
import Button from '../../components/button.astro';

import { SKATE_DISCIPLINES, BLOG_CATEGORY } from '../../data/skate-constants';
import type { SkateDisciplines, BlogCategory, } from '../../data/skate-constants';
import { getCollection } from 'astro:content';
import type {Page, GetStaticPaths} from 'astro';
import type { CollectionEntry } from 'astro:content';


const allPosts = await getCollection('posts');

const publishedPosts = allPosts
  .filter(p => p.data.status === 'published')
  .sort((a, b) => {
    const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
    const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
    return dateB - dateA;
  });


// 2. Set  "All/All" state
const discipline = 'all';
const category = 'all';
const pageSize = 8;

// 3. create 'page' object
const page = {
  data: publishedPosts.slice(0, pageSize),
  currentPage: 1,
  lastPage: Math.ceil(publishedPosts.length / pageSize),
  url: {
    prev: undefined,
    next: publishedPosts.length > pageSize ? '/blog/2/' : undefined
  }
};

// 4. Helpers
const getPageUrl = (num: number) => {
  if (num === 1) return '/blog/';
  return `/blog/${num}/`;
};

const getFilterUrl = (newDisc?: string, newCat?: string) => {
  const d = (newDisc || "all").toLowerCase();
  const c = (newCat || "all").toLowerCase();
  if (d === 'all' && c === 'all') return '/blog/';
  return `/blog/${d}/${c}/1/`;
};

// 5. Pagination 
const totalPages = page.lastPage;
const current = page.currentPage;
const delta = 1;
const range: number[] = [];
const rangeWithDots: (number | string)[] = [];
let l: number | undefined;

for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= current - delta && i <= current + delta)) {
    range.push(i);
  }
}
for (let i of range) {
  if (l) {
    if (i - l === 2) rangeWithDots.push(l + 1);
    else if (i - l !== 1) rangeWithDots.push('...');
  }
  rangeWithDots.push(i);
  l = i;
}

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const displayDisc = discipline === 'all' ? 'All Disciplines' : capitalize(discipline);
const displayCat = category === 'all' ? 'All Categories' : capitalize(category);

const pageTitle = `${displayDisc} - ${displayCat} ${page.currentPage > 1 ? `(Page ${page.currentPage})` : ''} | YJP Blog`;
const metaDescription = `Browse our collection of ${displayDisc} articles in the ${displayCat} category. Stay updated with the latest in the skating world!`;

const base = import.meta.env.BASE_URL;
---

<BaseLayout page_title={pageTitle} description={metaDescription}>
<nav class="navigation-controls">
  
  <Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/events'"> ← Previous Page </Button>

</nav>

  <section class="">
      <hgroup class="header-group">
          <h1>YJP BLOG</h1>
          <p>All Things SKATE</p>
      </hgroup>
  </section>
  
  <section class=" filter-bar">
    <div class="filter-group">
      <span class="filter-head">Discipline:</span>
      <nav class="filter-nav discipline">
        <a href={getFilterUrl('all', category)} class={discipline === "all" ? "active" : ""}>All</a>
        {SKATE_DISCIPLINES.map((disc) => (
            <a 
                href={getFilterUrl(disc.value, category)} 
                class={discipline === disc.value.toLowerCase() ? "active" : ""}
            >
                {disc.label}
            </a>
        ))}
      </nav>
      <span class="instruct-caption dis"> scroll ➤ </span>
    </div>
    <div class="filter-group">
      <span class="filter-head">Category:</span>
      <nav class="filter-nav category">
      <a href={getFilterUrl(discipline, 'all')} class={category === "all" ? "active" : ""}>All</a>
      {BLOG_CATEGORY.map((cat) => (
          <a 
              href={getFilterUrl(discipline, cat.value)} 
              class={category === cat.value.toLowerCase() ? "active" : ""}
          >
              {cat.label}
          </a>
      ))}
      </nav>
      <span class="instruct-caption cat"> scroll ➤ </span>
    </div>
  </section>

  <section class="blog-list ">
      {page.data.length > 0 ? (
      page.data.map((blog: CollectionEntry<'posts'>) => (
        
          <BlogCard 
          id={blog.id}
          url={`/blog/post/${blog.slug}/`} 
          {...blog.data}
          />
      ))
      ) : (
      <div class="empty-state">
          <h3>No posts found in this section</h3>
          <p>It looks like we haven't posted anything here yet. Check back soon!</p>
          <a href="/blog/" class="back-link">Back to all posts</a>
      </div>
      )}
  </section>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Blog pagination">
        <a href={page.url.prev} class={`nav-arrow ${!page.url.prev ? 'disabled' : ''}`}>&laquo;</a>

        <div class="number-list">
          {rangeWithDots.map((num) => {
            if (num === '...') {
                return <span class="dots">&hellip;</span>;
            }

            const pageNum = num as number;
            const isCurrent = current === pageNum;
            const dPath = discipline === 'all' ? '' : `/${discipline}`;
            const cPath = category === 'all' ? '' : `/${category}`;
            const url = `/blog${dPath}${cPath}/${pageNum}/`;
            // const url = num === 1 ? '/blog/' : `/blog/${num}/`;

            return (
              <a 
                href={url} 
                class={`page-num ${isCurrent ? 'active' : ''}`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {pageNum}
              </a>
            );
          })}
        </div>

        <a href={page.url.next} class={`nav-arrow ${!page.url.next ? 'disabled' : ''}`}>&raquo;</a>
    </nav>
    )}

</BaseLayout>


<style>

/* HEADER */

.header-group{
  padding-left: 3rem;
}


@media (max-width: 580px){
  .header-group{
    padding-left: 0;
  }
  
  .page-title-group{
      text-align: right;
    }
  }
  
  
  /* FILTER NAV */
  .filter-bar {
  padding-block: 0;
  padding-inline: .4rem;

}

.filter-group{
  padding: .5rem 0;
  display: flex;
  flex-direction: column;
}

.filter-group .filter-head {
  text-transform: uppercase;
  font-size: 0.8rem;
  font-weight: bold;
  letter-spacing: 0.1rem;
  color: var(--ob-teal);
}

.filter-nav{
  display: flex;
  gap: .5rem;
  padding: .4rem .2rem;
  border-radius: 8px;
  
}

.filter-nav.category a {
  text-decoration: none;
  color: var(--main-text);
  font-size: var(--fs-p2);
  transition: color 0.2s;
  text-align: center;
  align-content: center;
  border-inline: 2px solid var(--special-teal);
  border-inline: 2px solid var(--main-purple);
  border-radius: 4px;
  padding: .4rem;
}

.filter-nav.category a:hover,.filter-nav.category a.active {
  border-color: var(--special-teal);
  border-inline: 2px solid var(--main-purple);
  background: var(--special-teal);
  background: var(--shadow-purple);
}
.filter-nav.discipline a {
  text-decoration: none;
  color: var(--main-text);
  font-size: var(--fs-p2);
  transition: color 0.2s;
  text-align: center;
  align-content: center;
  border-inline: 2px solid var(--special-teal);
  border-radius: 4px;
  padding: .4rem;
}

.filter-nav.discipline a:hover,.filter-nav.discipline a.active {
  border-color: var(--special-teal);
  border-inline: 2px solid var(--main-teal);
  background: var(--special-teal);
  background: var(--shadow-teal);
}

.instruct-caption.dis {
  text-align: right;
  font-size: var(--fs-footer);
  color: var(--ob-teal);
}

.instruct-caption.cat {
  width: 100%;
  text-align: right;
  font-size: var(--fs-footer);
  color: var(--ob-purple);
}

.instruct-caption {
  visibility: hidden;
}

@media (max-width: 580px){
  a {
    text-wrap: nowrap;
  }

.filter-nav{
    display: flex;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    scrollbar-color: var(--shadow-grey) transparent;
    
  }
  
  .instruct-caption {
    visibility: visible;
  }
}


/* BLOG ITEMS */
.blog-list {
  display: flex;
  flex-direction: column;
  gap: 1rem; 
  max-width: 980px; 
  margin: 0 auto;
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1rem;
  margin-top: 4rem;
  font-family: 'Red Rose', sans-serif;
}

.number-list {
  display: flex;
  gap: 0.5rem;
}

.page-num, .nav-arrow {
  padding: 0.6rem 1rem;
  border: 2px solid var(--main-pink);
  color: var(--main-pink);
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
}

.page-num.active {
  background-color: var(--main-pink);
  color: white;
}

.page-num:hover:not(.active) {
  background-color: var(--main-pink);
}

.disabled {
  opacity: 0.3;
  pointer-events: none;
  border-color: gray;
  color: gray;
}

.dots {
  padding: 0.6rem 0.5rem;
  color: var(--main-pink);
  display: flex;
  align-items: flex-end; 
}

.empty-state {
    display: flex;
    flex-direction: column;
    
    text-align: center;
    justify-items: center;
    padding: 5rem 2rem;
    border: 2px dashed var(--main-pink);
    border-radius: 12px;
    margin-block: 2rem;
}

.empty-state h3 {
  color: var(--main-pink);
  font-size: var(--fs-heading-mid);
}


.back-link {
  display: inline-block;
  margin-top: 1.5rem;
  color: var(--ob-purple);
  text-decoration: underline;
  font-weight: bold;
}


</style>