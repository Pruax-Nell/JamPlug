---
import BaseLayout from '../../layouts/baseLayout.astro';
import BlogPost from '../../components/blogPost.astro'

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import { Image } from 'astro:assets';
import { object } from 'astro:schema';

const allPosts = await getCollection('blog');

const blogPosts = allPosts
  .filter((post: CollectionEntry<'blog'>) => {
    return post.data.status === 'published';
  })
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => {
    const dateA = a.data.published ? new Date(a.data.published).getTime() : 0;
    const dateB = b.data.published ? new Date(b.data.published).getTime() : 0;
    return dateB - dateA;
  });
 
const pageTitle = "Roll/Skate/Blog";
---
<BaseLayout page_title={pageTitle}>

  
  <h1>the new blog page...! </h1>
  <p>This is where I will post about my journey learning Astro. again</p>

  <span>Component test below</span>
  <ul>
    {blogPosts.map((blog: CollectionEntry<'blog'>) => (
      <BlogPost url={`/blog/${blog.id}/`} title={blog.data.title} />
    ))}
  </ul>

    <p>
      <a href="/tags/">tag list</a>
    </p>
</BaseLayout> 