---
import BaseLayout from "../layouts/baseLayout.astro";
import BigList from "../components/big-list.astro";

import '../styles/components.css'
import '../styles/global.css'
import '../styles/event.css'

import { getCollection } from "astro:content";
const bigEvents = await getCollection('events', ({ data }) => {
    return data.status === 'published' && data.eventType === 'Festival';
});

const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

const monthOrder = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];

const justAdded = (bigEvents)
.filter(
    event => {
        return event.data.published >= thirtyDaysAgo;
    }
)

const groupedEvents = bigEvents.reduce((acc: Record<string, any[]>, event) => {
    const month = event.data.startDate.toLocaleString(['en-GB', 'en-US'], { month: 'long' });
    
    // If this month doesn't exist in our object yet, create an empty array for it
    if (!acc[month]) {
        acc[month] = [];
    }
    
    // Push the event into the correct month bucket
    acc[month].push(event);
    
    return acc;
}, {});

// Sort events 
Object.values(groupedEvents).forEach(monthArray => {
    monthArray.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
});

const now = new Date();

// Helper function to calculate days left
// function getDaysRemaining(targetDate) {
//     const diffInMs = targetDate.getTime() - now.getTime();

//     const days = Math.ceil(diffInMs / (1000 * 60 * 60 * 24));
    
//     return days;
// }

---

<BaseLayout>
<section class="welcome">
    <div>
        <h1>Big Jam List</h1>
    </div>
    <div>
        <p>Bigger that your local Skate night!</p>
    </div>
    <div class="jam-req">
        <div class="tri-brick brick-1">
            <span class="side-a">What is a Skate Festival?</span>
            <span class="side-b">+ An overnight skate trip!</span>
        
        </div>
        <div class="tri-brick brick-2">
            <span class="side-a">Who is it for?</span>
            <span class="side-b">+ Something for all levels unless it specifies otherwise!</span>
        
        </div>
        <div class="tri-brick brick-3">
            <span class="side-a">Why go?</span>
            <span class="side-b">1. why not... 2. it's a holiday AND everyone will be skating</span>
        
        </div>
    </div>
</section>
<section>
    <div class="jam-direct"> 
        <span><a class="jam-year-button-down jam-year-button"> 2025 </a></span>
        <h2 class="year-title">2026</h2>
        <span><a class="jam-year-button-up jam-year-button"> 2027 </a></span>
    </div>
    <div id="jam-list">
        <div>
            {monthOrder.map((month) => {
            // 1. Try to find events for this month in our grouped object
            const eventsInMonth = groupedEvents[month] || [];

            return (
            <div class="month-block">
                <h2>{month}</h2>

                {eventsInMonth.length > 0 ? (
                <ul>
                    {eventsInMonth.map((event) => (
                    <li class="jam-item"><a href={`/events/${event.id}/`}>
                            
                        <div class="jam-content">
                            <div class="jam-title">
                                {event.data.published >= thirtyDaysAgo && (
                                    <span class="highlight-new ">NEW!</span>
                                )}
                                    
                                <div class="jam-bold">
                                    <p>{event.data.eventName} </p>
                                    <p>{event.data.description}</p>
                                </div>
                            </div>

                            <div class="divider">  </div>

                            <div class="jam-info">
                                <p>{event.data.townCity} - {event.data.country}</p>

                                <p>{event.data.startDate.toDateString()}</p>
                            </div>
                        </div>
                    </a></li>
                    ))}
                </ul>
                ) : (
                <p class="no-events">...</p>
                )}
            </div>
            );
            })}
        </div>
        
    </div>
</section>
<section >
    <div class="middle">
        <p>looking for more events? </p>
        <a href="/events" class="tertiary-button"> Browse the event list </a>
    </div>
</section>


</BaseLayout>

<style>

    .middle{
        justify-items: center;
        align-content: center;
        margin: .5rem;
        height: 220px;
        border-top: 13px double var(--ow-orange) ;
        border-bottom: 13px double var(--ow-orange) ;
    }

    .welcome {
        justify-items: center;
    }

    .jam-req {
        display: flex;
        /* gap: 2%; */
        justify-content: space-around;

    }

    .tri-brick{
        width: 200px;
        height: 120px;
        padding: .5rem;
        text-align: center;
        border-radius: 4px;
        align-content: center;
    }

    .side-b{
        display: none;
    }
    
    .tri-brick:hover{
        background-color: var(--shadow-purple);

        .side-b{
            display: block;
        }

        .side-a{
            display: none;
        }
    }

    .jam-direct {
        display: flex;
        justify-content: center;
        gap: 60px;
        align-content: center;
    }

    .jam-direct span {
        align-content: center;
    }

    .year-title {
        justify-self: center;
        font-size: var(--fs-title);
    }

    .jam-year-button{
        letter-spacing: .3ch;
        padding: .6rem 1rem;
        background-color: var(--grey-teal);
    }

    .jam-year-button:hover{
        /* background-color: var(--mid-teal); */
        cursor: default;
        
    }
    .jam-year-button-up {
        opacity: 30%;
        border-radius: 8px 25px 25px 8px;
        
    }
    .jam-year-button-down {
        opacity: 30%;
        border-radius: 25px 8px 8px 25px;
        
    }

    
    .jam-bold{
        font-size: var(--fs-p2);
    }
    
    .highlight-new {
        height: 40px;
        width: 70px;
        /* padding: 1ch; */
        border-radius: 14px;
        font-size: var(--fs-footer);

        color: var(--text-white);
        font-weight: 400;
        background: linear-gradient(45deg, var(--grey-pink), var(--mid-purple));
        text-align: center;
        align-content: center;
        justify-self: right;

        animation: pulse 1.8s infinite;

    }

    @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

    .divider {
        align-content: center;
        width: .2fr;
    }

    .jam-item {
        display: flex;
        flex-direction: row;
        width: 100%;
    }

    .jam-item a {
        width: 100%;
    }

    .jam-content {
        display: grid;
        grid-template-columns: auto 10px auto;
    }

    .jam-content  * {
        margin: .5rem;
        padding: 0;
    }

    .jam-title  {
        display: flex;
        flex-direction: row;
        height: max-content;
        /* width: 2fr; */
        justify-content:space-between;
    }

    .jam-info {
        display: flex;
        flex-direction: column;
        height: max-content;
        width: 1fr;
    }

    .month-block{
        padding: .7rem;
    }
    .month-block h2 {
        justify-self: left;
        margin-left: 3rem;
        font-size: var(--fs-heading-mid);
    }

    .month-block ul {
        padding-left: 0;
    }


</style> 