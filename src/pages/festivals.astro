---
import BaseLayout from "../layouts/baseLayout.astro";
import BigList from "../components/big-list.astro";

import '../styles/components.css'
import '../styles/global.css'
import '../styles/event.css'

import { getCollection } from "astro:content";
const bigEvents = await getCollection('events', ({ data }) => {
    return data.status === 'published' && data.eventType === 'Festival';
});

const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

const monthOrder = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];

const justAdded = (bigEvents)
.filter(
    event => {
        return event.data.published >= thirtyDaysAgo;
    }
)

const groupedEvents = bigEvents.reduce((acc: Record<string, any[]>, event) => {
    const month = event.data.startDate.toLocaleString(['en-GB', 'en-US'], { month: 'long' });
    
    // If this month doesn't exist in our object yet, create an empty array for it
    if (!acc[month]) {
        acc[month] = [];
    }
    
    // Push the event into the correct month bucket
    acc[month].push(event);
    
    return acc;
}, {});

// Sort events 
Object.values(groupedEvents).forEach(monthArray => {
    monthArray.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
});

const now = new Date();

// Helper function to calculate days left
function getDaysRemaining(targetDate) {
    const diffInMs = targetDate.getTime() - now.getTime();

    const days = Math.ceil(diffInMs / (1000 * 60 * 60 * 24));
    
    return days;
}

