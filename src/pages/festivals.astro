---
import BaseLayout from "../layouts/baseLayout.astro";
import BigList from "../components/big-list.astro";
import CardHolder from "../components/card-holder.astro";

import '../styles/components.css'
import '../styles/global.css'
import '../styles/event.css'
import '../styles/home.css'

import { getCollection } from "astro:content";
const bigEvents = await getCollection('events', ({ data }) => {
    return data.status === 'published' && data.eventType === 'Festival';
});

const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

const monthOrder = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
];

// const justAdded = (bigEvents)
// .filter(
//     event => {
//         return event.data.published >= thirtyDaysAgo;
//     }
// )

const groupedEvents = bigEvents.reduce((acc: Record<string, any[]>, event) => {
    const month = event.data.startDate.toLocaleString(['en-GB', 'en-US'], { month: 'long' });
    
    if (!acc[month]) {
        acc[month] = [];
    }
    
    acc[month].push(event);
    
    return acc;
}, {});

Object.values(groupedEvents).forEach(monthArray => {
    monthArray.sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
});


// Helper function to calculate days left
// function getDaysRemaining(targetDate) {
//     const diffInMs = targetDate.getTime() - now.getTime();

//     const days = Math.ceil(diffInMs / (1000 * 60 * 60 * 24));
    
//     return days;
// }

// GENERAL UTILITY
const now = new Date();
now.setHours(0, 0, 0, 0);


// UPCOMING EVENTS
const publishedEvents = await getCollection('events', ({ data }) => {
  return data.status === 'published';
});

const upcomingEvents = (publishedEvents)
.map(event => ({
	id: event.id,
	title: event.data.eventName,
	poster: event.data.eventPoster,
	city: event.data.townCity,
	country: event.data.location.discriminant,
	description: event.data.description,
	eventType: event.data.eventType,
	featured: event.data.isFeatured,
	timeframe: {
		startDate: new Date(event.data.startDate),
		endDate: event.data.endDate ? new Date(event.data.endDate) : null
	}
	
}))
.sort(
	(a, b) => b.timeframe.startDate.valueOf() - a.timeframe.startDate.valueOf(),
)
.slice(0, 8);

---

<BaseLayout>
<section class="frame-fence welcome">
    <hgroup>
        <h1>Big Jam List</h1>
        <p>Bigger that your local Skate night!</p>
    </hgroup>

    <div class="jam-req">
        <p><span class="bold-point ">Q:</span> What is a Skate Festival?</p>
        <p><span class="bold-point ">A:</span> A Multi-night, schedule-packed, skate-escape! Worth waiting all year for~</p>
        <p class="note">How we catagorise events: <a href="/ourProcess/#YJP=FAQ"> Check our F.A.Q here</a></p>
    </div>
</section>
<section class="frame-fence">
    <div class="jam-direct"> 
        <span><a class="jam-year-button-down jam-year-button"> 2025 </a></span>
        <h2 class="year-title">2026</h2>
        <span><a class="jam-year-button-up jam-year-button"> 2027 </a></span>
    </div>
    <div id="jam-list">
        {monthOrder.map((month) => {
        const eventsInMonth = groupedEvents[month] || [];

        return (
        <div class="month-block">
            <h2>{month}</h2>

            {eventsInMonth.length > 0 ? (
            <ul>
                {eventsInMonth.map((event) => (
                <li class="jam-item"><a href={`/events/${event.id}/`}>
                        
                    <div class="jam-content">
                        <div class="jam-title">
                            {event.data.published >= thirtyDaysAgo && (
                                <span class="highlight-new ">NEW!</span>
                            )}
                                
                            <div class="jam-bold">
                                <p>{event.data.eventName} </p>
                                <p>{event.data.description}</p>
                            </div>
                        </div>

                        <div class="divider">  </div>

                        <div class="jam-info">
                            <p>{event.data.townCity} - {event.data.country}</p>

                            <p>{event.data.startDate.toDateString()}</p>
                        </div>
                    </div>
                </a></li>
                ))}
            </ul>
            ) : (
            <p class="no-events">...</p>
            )}
        </div>
        );
        })}
        
    </div>
</section>
<section class="frame-fence">
    <h4>General Upcoming Events: </h4>
    <!-- <a href="/events" class="tertiary-button"> Browse the event list </a> -->
    {upcomingEvents.length > 0 ? (
				<div class="carosel" role="list" aria-label="Upcoming Events">
			{upcomingEvents.map((post) => (
				<CardHolder 
				variant="event"
				title={post.title}
				url={`/events/${post.id}/`}
				poster={post.poster}
				city={post.city}
				country={post.country}
				timeframe={post.timeframe}
				description={post.description}
				/>
			))}

			<CardHolder 
				variant="placeholder"
				title="See more Events"
				url="/events"
				description="Browse All Events"
			/>
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>no events to show yet</p></div>)}
</section>


</BaseLayout>

<style>
    .welcome {
        justify-items: center;
        min-height: 10rem;
        background-color: var(--shadow-purple);
        border-radius: 0 0 22px 22px;
        padding: .5rem;
        gap: 2rem;
    }

    @media (max-width: 620px){
        .welcome {
            padding-top: 3rem;
        }
    }

    .bold-point{
        background-color: var(--second-teal);
        border-radius: 8px;
        padding: .1rem .3rem;
        font-size: var(--fs-p1);
        font-weight: 800;
    }

    
    .jam-req {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: space-around;
        margin-block: 2rem;
        max-width: 65ch;
        
    }

    #jam-list {
        background-color: var(--main-teal);
        background-color: var(--shadow-orange-2);
        border-radius: 28px;
        padding: 3rem .8rem;
    }
    
    .middle{
        justify-items: center;
        align-content: center;
        margin: .5rem;
        height: 220px;
        border-top: 13px double var(--ow-orange) ;
        border-bottom: 13px double var(--ow-orange) ;
    }


   

    .jam-direct {
        display: flex;
        justify-content: center;
        gap: 60px;
        align-content: center;
    }

    .jam-direct span {
        align-content: center;
    }

    .year-title {
        justify-self: center;
        font-size: var(--fs-title);
    }

    .jam-year-button{
        letter-spacing: .3ch;
        padding: .6rem 1rem;
        background-color: var(--grey-teal);
    }

    .jam-year-button:hover{
        /* background-color: var(--mid-teal); */
        cursor: default;
        
    }
    .jam-year-button-up {
        opacity: 30%;
        border-radius: 8px 25px 25px 8px;
        
    }
    .jam-year-button-down {
        opacity: 30%;
        border-radius: 25px 8px 8px 25px;
        
    }

    
    .jam-bold{
        font-size: var(--fs-p2);
    }
    
    .highlight-new {
        height: 40px;
        width: 70px;
        /* padding: 1ch; */
        border-radius: 14px;
        font-size: var(--fs-footer);

        color: var(--text-white);
        font-weight: 400;
        background: linear-gradient(45deg, var(--grey-pink), var(--mid-purple));
        text-align: center;
        align-content: center;
        justify-self: right;

        animation: pulse 1.8s infinite;

    }

    @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

    .divider {
        align-content: center;
        width: .2fr;
    }

    .jam-item {
        display: flex;
        flex-direction: row;
        width: 100%;
    }

    .jam-item a {
        width: 100%;
    }

    .jam-content {
        display: grid;
        grid-template-columns: auto 10px auto;
    }

    .jam-content  * {
        margin: .5rem;
        padding: 0;
    }

    .jam-title  {
        display: flex;
        flex-direction: row;
        height: max-content;
        /* width: 2fr; */
        justify-content:space-between;
    }

    .jam-info {
        display: flex;
        flex-direction: column;
        height: max-content;
        width: 1fr;
    }

    .month-block{
        padding: .7rem;
    }
    .month-block h2 {
        justify-self: left;
        margin-left: 3rem;
        font-size: var(--fs-heading-mid);
    }

    .month-block ul {
        padding-left: 0;
    }


</style> 