---
const Brand = "Your Jam Plug.UK";

import BaseLayout from "../layouts/baseLayout.astro";
import EventCard from "../components/eventCard.astro";
import SampleBlogCard from "../components/sampleBlogCard.astro";
import SampleEventCard from "../components/sampleEventCard.astro";

import EndSamplecard from "../components/endsamplecard.astro"

import "../styles/global.css";
import "../styles/home.css";
import "../styles/components.css";

import { getCollection, getEntries } from "astro:content";
import { Image } from "astro:assets";

import Hero from '../components/hero.astro';
import Img1 from "../assets/layout/image1.jpg"
import Img2 from "../assets/layout/image2.jpg"
import Img3 from "../assets/layout/image3.jpg"
import Img4 from "../assets/layout/image4.jpg"
import Img5 from "../assets/layout/image5.jpg"
import Img6 from "../assets/layout/image6.jpg"
import Img7 from "../assets/layout/image7.jpg"
import Img8 from "../assets/layout/image8.jpg"
import Img9 from "../assets/layout/image9.jpg"
import Img10 from "../assets/layout/image10.jpg"

const identity = {
	branding: "your jam plug uk",
	based: "Europe",
	targetAudience: ["roller skater", "inline skater", "free skater"]
};

// GENERAL UTILITY
const now = new Date();
now.setHours(0, 0, 0, 0);

const twoweeksTime = new Date();
twoweeksTime.setDate(now.getDate() + 14);


// FEATURED EVENTS
const features = await getCollection('events', ({ data }) => {
	return data.isFeatured === true && data.status === 'published';
});

// UPCOMING EVENTS
const publishedEvents = await getCollection('events')
console.log(publishedEvents)

const upcomingEvents = (publishedEvents)
.filter(
	event => {
		return event.data.startDate >= now && + twoweeksTime;
	})
	.sort(
		(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
	)
	.slice(7);
	
	// BLOG COLLECTION
	const publishedBlogs = await getCollection('blogs')
	
	const recentBlogs = (publishedBlogs)
	.filter( (post) => post.data.status === 'published')
	.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf(), )
	.slice(7);
	
	

---
	
<BaseLayout>
	<!------------------------------------------ HERO ---------------->
	<section  id="hero-section" class="section scroll-snap">
		<Hero />
	</section>
	
	<!------------------------------------------ MISSION ---------------->
	<section id="our-mission" class=" scroll-snap stack-section stack-1">
		<div class="l-top heading-banner">
			<h3>Helping skater's skate</h3>
			<span>our mission in the skate community</span>
		</div>
		
		<div class="l-mid">
			<div class="nav-button"><a href="/about" class="primary-button">Read our mission statement</a></div>
		</div>
		
	</section>
	<!------------------------------------------ JAM LIST ---------------->
	<section id="festival-list" class="section scroll-snap center-focus">
		<div class="blur-back-1 center-div">
			<div >
				<h3 class="title">2026 Big Jam List</h3>
				<span class="sub-heading">All the Skate Festivals of Europe</span>
			</div>
			<div class="items-center">
				<div class="secondary-button"><a href="/festivals" class="button-light">Big Jam List of Skate Festivals</a></div>
			</div>
		</div>
		
	</section>
	<!------------------------------------------ DIRECTORY ---------------->
	<section id="learn-to-skate" class=" scroll-snap stack-section stack-2">
		<div class="l-top heading-banner">
			<h3>To the directory</h3>
			<span>The A-to-Z of Skating</span>
			<p>Find rinks, skate shops and groups who hold lessons or events</p>
		</div>
		<div class="l-mid ">
			<div class="nav-button"><a href="/directory" class="primary-button">Browse the Directory</a></div>
		</div>
		
	</section>
	<!------------------------------------------ UPCOMING ---------------->
	<section id="upcoming-events" class="section scroll-snap side-by-side" >
		<div class="side-a">
			<h3>Upcoming Events</h3>
			<a href="/events">What's coming up next?</a>
			<p>small carosel of some events. maybe featured</p>
			<p>direct to main event page</p>
		</div>
		<div class=" event-previews side-b">

			{publishedEvents.length > 0 ? (
				<div class="carosel"> 
				{/* map/dynamic list */}
			{publishedEvents.map((post) =>
				( <SampleEventCard title={post.data.eventName} url={`/events/${post.id}/`} poster={`/content/flyers/${post.data.eventPoster}`} tags={post.data.category} description={post.data.description} date={post.data.startDate} city={post.data.townCity} country={post.data.country}
				/>
			))}
			{/* add the end card */}
			<EndSamplecard title="See more Events" url="/events" description="Click me" />
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>no events found</p></div>)}
			
		</div>

	</section>
	<!------------------------------------------ BLOGS ---------------->
	<section id="skate-news" class="section scroll-snap side-by-side">
		<div class="side-a">
			<h3>Skate News</h3>
			<span>Direct to blog page</span>
			<a href="/blog">Blog page</a>
		</div>
		<div class="side-b">
			{publishedBlogs.length > 0 ? (
				<div class="carosel"> 
				{/* map/dynamic list */}
			{publishedBlogs.map((post) =>
				( <SampleBlogCard title={post.data.title} url={`/blog/${post.id}/`}  tags={post.data.tags} description={post.data.description}
				/>
			))}
			{/* add the end card */}
			<EndSamplecard title="See more Posts" url="/blog/" description="Click me" />
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>~No blog posts found~</p></div>)}
			
		</div>
	</section>
	
</BaseLayout>

<style>

	.cube {
		width: 150px;
		height: 180px;
		border: 1.8px solid rgb(61, 61, 35);
		background-color: rgb(228, 160, 91);
	}

</style>