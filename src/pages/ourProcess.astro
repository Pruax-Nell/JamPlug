    max-width: 45ch;
    font-size: var(--fs-p3);
    font-weight: normal;
}

 ul li {
    padding: 1rem;
 }


.reach-us{
    justify-items: center;
}
.enquire-button{
    margin-block: .3rem;
    padding: 1rem;
