---
const Brand = "Your Jam Plug.UK";

import BaseLayout from "../layouts/baseLayout.astro";
import SampleBlogCard from "../components/sampleBlogCard.astro";
import SampleEventCard from "../components/sampleEventCard.astro";
import FeaturedCard from '../components/featuredCard.astro';
import Button from '../components/button.astro';
import EndSamplecard from "../components/endsamplecard.astro";
import CardHolder from "../components/card-holder.astro";

import "../styles/home.css";
import "../styles/components.css";

import { Image } from "astro:assets";
import { getCollection, getEntries } from "astro:content";

import Hero from '../components/hero.astro';
import Img1 from "../assets/layout/image1.jpg"
import Img2 from "../assets/layout/image2.jpg"
import Img3 from "../assets/layout/image3.jpg"
import Img4 from "../assets/layout/image4.jpg"
import Img5 from "../assets/layout/image5.jpg"
import Img6 from "../assets/layout/image6.jpg"
import Img7 from "../assets/layout/image7.jpg"
import Img8 from "../assets/layout/image8.jpg"
import Img9 from "../assets/layout/image9.jpg"
import Img10 from "../assets/layout/image10.jpg"

const identity = {
	branding: "your jam plug uk",
	based: "Europe",
	targetAudience: ["roller skater", "inline skater", "free skater"]
};

// GENERAL UTILITY
const now = new Date();
now.setHours(0, 0, 0, 0);


// UPCOMING EVENTS
const publishedEvents = await getCollection('events', ({ data }) => {
  return data.status === 'published';
});

const upcomingEvents = (publishedEvents)
.map(event => ({
	id: event.id,
	title: event.data.eventName,
	poster: event.data.eventPoster,
	city: event.data.townCity,
	country: event.data.location.discriminant,
	description: event.data.description,
	eventType: event.data.eventType,
	featured: event.data.isFeatured,
	timeframe: {
		startDate: new Date(event.data.startDate),
		endDate: event.data.endDate ? new Date(event.data.endDate) : null
	}
	
}))
.sort(
	(a, b) => b.timeframe.startDate.valueOf() - a.timeframe.startDate.valueOf(),
)
.slice(0, 8);

// FEATURED EVENTS
const featuredEvents = (publishedEvents)
.filter((event) => event.data.isFeatured === true)
.map(event => ({
	id: event.id,
	title: event.data.eventName,
	poster: event.data.eventPoster,
	city: event.data.townCity,
	country: event.data.location.discriminant,
	description: event.data.description,
	eventType: event.data.eventType,
	featured: event.data.isFeatured,
	timeframe: {
		startDate: new Date(event.data.startDate),
		endDate: event.data.endDate ? new Date(event.data.endDate) : null
	}
	
}))
.sort(
	(a, b) => b.timeframe.startDate.valueOf() - a.timeframe.startDate.valueOf(),
);
	
// BLOG COLLECTION
const publishedBlogs = await getCollection('blog', ({ data }) => {
  return data.status === 'published';
});

const recentBlogs = (publishedBlogs)
.map(event => ({
	id: event.id,
	title: event.data.title,
	subtitle: event.data.subtitle,
	published: event.data.published,
	poster: event.data.coverImage,
	description: event.data.description,
	category: event.data.blogCategory,
	discipline: event.data.skateDiscipline,
	
}))
.sort((a, b) => b.published.valueOf() - a.published.valueOf(), )
.slice(0, 8);

	

---
	
<BaseLayout>
	<!------------------------------------------ HERO ---------------->
	<section  id="hero-section" class="frame-fence scroll-snap">
		<Hero />
	</section>

	<!------------------------------------------ MISSION ---------------->
	<section id="our-mission" class="frame-fence scroll-snap  ">
		<div class=" heading-banner">
			<h3>Helping skater's skate</h3>
			<span class="p1">Mission Statement: "For the Skaters"</span>
		</div>
		
		<div class="nav-button center-flex">
			<Button href="/about" variant="secondary" theme="brownDark" size="lg" class=""> Read about Us </Button>
		</div>
		
	</section>
	<!------------------------------------------ FEATURES ---------------->
	{featuredEvents.length > 0 ? (
		<section id="feature-section"  class="frame-fence">
			<div><h3>Featured Events</h3></div>
			<div class="carosel">
		{featuredEvents.map((post) => (
				<FeaturedCard timeframe={post.timeframe} title={post.title} url={`/events/${post.id}/`} poster={post.poster} description={post.description} city={post.city} country={post.country} eventType={post.eventType}/>
			))}
			</div>
			<div class='big-space'></div>
		</section>
	) : (<span>special</span>) } 

	<!------------------------------------------ JAM LIST ---------------->
	<section id="festival-list" class="frame-fence scroll-snap">
		<div class="blur-back-1 center-div">
			<div class="">
				<h3 class="title"> Big Jam List <span class="year-highlight">2026</span> </h3>
				<!-- <span class="sub-heading">All the Skate Festivals of Europe</span> -->
			</div>
			<div class="items-center">
				<Button href="/festivals" variant="tertiary" theme="pinkLight" size="lg"> Find Skate Festivals </Button>
			</div>
		</div>
		
	</section>
	<!------------------------------------------ DIRECTORY ---------------->
	<section id="learn-to-skate" class="frame-fence scroll-snap ">
		<div class="heading-banner">
			<h3>To the directory</h3>
			<span>Your A-to-Z of Skating</span>
			<p class="narrow-ch self-center p1">Find rinks, skate shops and community groups who hold lessons or events</p>
		</div>
		<div class="nav-button center-flex">
			<Button href="/directory" variant="secondary" theme="brownDark" size="lg"> Browse the UK Directory </Button>
		</div>
	
	</section>
	<!------------------------------------------ UPCOMING ---------------->
	<section id="upcoming-events" class="frame-fence scroll-snap side-by-side" >
		<div class="side-a">
			<h4>Upcoming Events</h4>
			<div><Button href="/events" variant="secondary" theme="yellowLight" size="xs"> See All Events </Button></div>
			<p>small carosel of some events. maybe featured</p>
			<p>direct to main event page</p>
		</div>
		<div class=" event-previews side-b">

			{upcomingEvents.length > 0 ? (
				<div class="carosel">
			{upcomingEvents.map((post) => (
				<CardHolder 
				variant="event"
				title={post.title}
				url={`/events/${post.id}/`}
				poster={post.poster}
				city={post.city}
				country={post.country}
				timeframe={post.timeframe}
				description={post.description}
				/>
			))}

			<CardHolder 
				variant="placeholder"
				title="See more Events"
				url="/events"
				description="Browse All Events"
			/>
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>no events to show yet</p></div>)}
			
		</div>

	</section>
	<!------------------------------------------ BLOGS ---------------->
	<section id="skate-news" class="frame-fence scroll-snap side-by-side">
		<div class="side-a">
			<h4>Skate News</h4>
			<span>Direct to blog page</span>
			<div><Button href="/blog" variant="secondary" theme="orangeDark" size="xs"> See All Blog Posts </Button></div>
		</div>
		<div class="side-b">
			{recentBlogs.length > 0 ? (
				<div class="carosel"> 
			{recentBlogs.map((post) =>
				( <CardHolder variant="blog" 
				title={post.title} 
				url={`/blog/${post.id}/`} 
				subtitle={post.subtitle}  
				description={post.description} 
				category={post.category} discipline={post.discipline}
				/>
			))}
				<CardHolder 
				variant="placeholder" 
				title="See more Posts" 
				url="/blog/" 
				description="Browse More Blog Posts" 
				/>
			</div> ) 
			: 
			(<div class="none-returned"><p>~No blog posts yet~</p></div>)}
			
		</div>
	</section>
	
</BaseLayout>

