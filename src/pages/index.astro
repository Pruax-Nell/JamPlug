---
const Brand = "Your Jam Plug.UK";

import BaseLayout from "../layouts/baseLayout.astro";
import SampleBlogCard from "../components/sampleBlogCard.astro";
import SampleEventCard from "../components/sampleEventCard.astro";
import FeaturedCard from '../components/featuredCard.astro';
import Button from '../components/button.astro';
import EndSamplecard from "../components/endsamplecard.astro";

import "../styles/home.css";
import "../styles/components.css";

import { Image } from "astro:assets";
import { getCollection, getEntries } from "astro:content";

import Hero from '../components/hero.astro';
import Img1 from "../assets/layout/image1.jpg"
import Img2 from "../assets/layout/image2.jpg"
import Img3 from "../assets/layout/image3.jpg"
import Img4 from "../assets/layout/image4.jpg"
import Img5 from "../assets/layout/image5.jpg"
import Img6 from "../assets/layout/image6.jpg"
import Img7 from "../assets/layout/image7.jpg"
import Img8 from "../assets/layout/image8.jpg"
import Img9 from "../assets/layout/image9.jpg"
import Img10 from "../assets/layout/image10.jpg"

const identity = {
	branding: "your jam plug uk",
	based: "Europe",
	targetAudience: ["roller skater", "inline skater", "free skater"]
};

// GENERAL UTILITY
const now = new Date();
now.setHours(0, 0, 0, 0);


// UPCOMING EVENTS
const publishedEvents = await getCollection('events', ({ data }) => {
  return data.status === 'published';
});

const upcomingEvents = (publishedEvents)
.map(event => ({
	id: event.id,
	title: event.data.eventName,
	poster: event.data.eventPoster,
	city: event.data.townCity,
	country: event.data.country,
	description: event.data.description,
	eventType: event.data.eventType,
	featured: event.data.isFeatured,
	timeframe: {
		startDate: new Date(event.data.startDate),
		endDate: event.data.endDate ? new Date(event.data.endDate) : null
	}
	
}))
.sort(
	(a, b) => b.timeframe.startDate.valueOf() - a.timeframe.startDate.valueOf(),
)
.slice(0, 8);

// FEATURED EVENTS
const featuredEvents = (publishedEvents)
.filter((event) => event.data.isFeatured === true)
.map(event => ({
	id: event.id,
	title: event.data.eventName,
	poster: event.data.eventPoster,
	city: event.data.townCity,
	country: event.data.country,
	description: event.data.description,
	eventType: event.data.eventType,
	featured: event.data.isFeatured,
	timeframe: {
		startDate: new Date(event.data.startDate),
		endDate: event.data.endDate ? new Date(event.data.endDate) : null
	}
	
}))
.sort(
	(a, b) => b.timeframe.startDate.valueOf() - a.timeframe.startDate.valueOf(),
);
	
// BLOG COLLECTION
const publishedBlogs = await getCollection('blog')

const recentBlogs = (publishedBlogs)
.filter( (post) => post.data.status === 'published')
.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf(), )
.slice(0, 8);

	

---
	
<BaseLayout>
	<!------------------------------------------ HERO ---------------->
	<section  id="hero-section" class="section scroll-snap">
		<Hero />
	</section>

	<!------------------------------------------ MISSION ---------------->
	<section id="our-mission" class=" scroll-snap stack-section stack-1">
		<div class="l-top heading-banner">
			<h3>Helping skater's skate</h3>
			<span>our mission in the skate community</span>
		</div>
		
		<div class="l-mid">
			<div class="nav-button">
				<Button href="/about" variant="secondary" theme="brownDark" size="lg"> Read More </Button>
			</div>
		</div>
		
	</section>
	<!------------------------------------------ FEATURES ---------------->
	{featuredEvents.length > 0 ? (
		<section id="feature-section" >
			<div><h3>Featured Events</h3></div>
			<div class="carosel">
		{featuredEvents.map((post) => (
				<FeaturedCard timeframe={post.timeframe} title={post.title} url={`/events/${post.id}/`} poster={post.poster} description={post.description} city={post.city} country={post.country} eventType={post.eventType}/>
			))}
			</div>
			<div class='big-space'></div>
		</section>
	) : (<span>special</span>) } 

	<!------------------------------------------ JAM LIST ---------------->
	<section id="festival-list" class="section scroll-snap center-focus">
		<div class="blur-back-1 center-div">
			<div >
				<h3 class="title">2026 Big Jam List</h3>
				<span class="sub-heading">All the Skate Festivals of Europe</span>
			</div>
			<div class="items-center">
				<div class="secondary-button">
					<Button href="/festivals" variant="primary" theme="pinkLight" size="lg"> Read More </Button>
				</div>
			</div>
		</div>
		
	</section>
	<!------------------------------------------ DIRECTORY ---------------->
	<section id="learn-to-skate" class=" scroll-snap stack-section stack-2">
		<div class="l-top heading-banner">
			<h3>To the directory</h3>
			<span>The A-to-Z of Skating</span>
			<p>Find rinks, skate shops and groups who hold lessons or events</p>
		</div>
		<div class="l-mid ">
			<div class="nav-button">
				<Button href="/directory" variant="secondary" theme="brownDark" size="lg"> Read More </Button>
			</div>
		</div>
		
	</section>
	<!------------------------------------------ UPCOMING ---------------->
	<section id="upcoming-events" class="section scroll-snap side-by-side" >
		<div class="side-a">
			<h4>Upcoming Events</h4>
			<Button href="/events" variant="secondary" theme="yellowLight" size="xs"> Read More </Button>
			<p>small carosel of some events. maybe featured</p>
			<p>direct to main event page</p>
		</div>
		<div class=" event-previews side-b">

			{upcomingEvents.length > 0 ? (
				<div class="carosel"> 
			{upcomingEvents.map((post) =>
				( <SampleEventCard timeframe={post.timeframe} title={post.title} url={`/events/${post.id}/`} poster={post.poster} description={post.description} city={post.city} country={post.country} eventType={post.eventType}
				/>
			))}
			<EndSamplecard title="See more Events" url="/events" description="Click me" />
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>no events found</p></div>)}
			
		</div>

	</section>
	<!------------------------------------------ BLOGS ---------------->
	<section id="skate-news" class="section scroll-snap side-by-side">
		<div class="side-a">
			<h4>Skate News</h4>
			<span>Direct to blog page</span>
			<Button href="/blog" variant="secondary" theme="orangeDark" size="xs"> Read More </Button>
		</div>
		<div class="side-b">
			{publishedBlogs.length > 0 ? (
				<div class="carosel"> 
				{/* map/dynamic list */}
			{publishedBlogs.map((post) =>
				( <SampleBlogCard title={post.data.title} url={`/blog/${post.id}/`} description={post.data.description}
				/>
			))}
			{/* add the end card */}
			<EndSamplecard title="See more Posts" url="/blog/" description="Click me" />
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>~No blog posts found~</p></div>)}
			
		</div>
	</section>
	
</BaseLayout>

