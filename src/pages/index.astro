---
const Brand = "Your Jam Plug.UK";

import BaseLayout from "../layouts/baseLayout.astro";
import FeaturedCard from '../components/featuredCard.astro';
import Button from '../components/button.astro';
import CardHolder from "../components/card-holder.astro";

import "../styles/home.css";
import "../styles/components.css";

import { Image } from "astro:assets";
import { getCollection, getEntries } from "astro:content";
import { formatLabel } from "../function/stringHelper";
import { formatLocation } from "../data/globe-constants";
import { formatFestivalDate, formatEventDate, formatDate } from "../function/dateHelper";

import Hero from '../components/hero.astro';
import Img1 from "../content/images/use/image1.jpg"
import Img2 from "../content/images/use/image2.jpg"
import Img3 from "../content/images/use/image3.jpg"
import Img4 from "../content/images/use/image4.jpg"
import Img5 from "../content/images/use/image5.jpg"
import Img6 from "../content/images/use/image6.jpg"
import Img7 from "../content/images/use/image7.jpg"
import Img8 from "../content/images/use/image8.jpg"
import Img9 from "../content/images/use/image9.jpg"
import Img10 from "../content/images/use/image10.jpg"

import { CURRENT_YEAR, SHOW_JAN_BANNER, SHOW_MAY_BANNER, SHOW_NOV_BANNER, SHOW_SEPT_BANNER } from "../data/site-config";
import NoticeBanner from "../components/noticeBanner.astro";

const identity = {
	branding: "your jam plug uk",
	based: "Europe",
	targetAudience: ["roller skater", "inline skater", "free skater"]
};

// GENERAL UTILITY
const now = new Date();
now.setHours(0, 0, 0, 0);

// UPCOMING EVENTS
const publishedEvents = await getCollection('events', ({ data }) => {
  return data.status === 'published';
});

const upcomingEvents = (publishedEvents)
.map(event => ({
	id: event.id,
	title: event.data.eventName,
	poster: event.data.eventPoster,
	city: event.data.townCity,
	country: event.data.location.discriminant,
	description: event.data.description,
	eventType: event.data.eventType,
	featured: event.data.isFeatured,
	timeframe: {
		startDate: new Date(event.data.startDate),
		endDate: event.data.endDate ? new Date(event.data.endDate) : null
	}
	
}))
.sort(
	(a, b) => b.timeframe.startDate.valueOf() - a.timeframe.startDate.valueOf(),
)
.slice(0, 8);

// FEATURED EVENTS
const featuredEvents = publishedEvents
  .filter((event) => event.data.isFeatured === true)
  .map(event => {
    const location = formatLocation(event.data.location, event.data.townCity);
	const dates = formatEventDate(event.data.startDate, event.data.endDate);
	const poster = event.data.eventPoster;
    
    return {
	
      id: event.id,
	  url: `/events/${event.id}/`,
      title: event.data.eventName,
      poster: poster ? poster.src : null,
      description: event.data.description,
      eventType: event.data.eventType,
      locationLabel: location.full, // "London, England, UK"
      dateLabel: dates,
	  startOrder: event.data.startDate,
    };
  })
  .sort((a, b) => b.startOrder.valueOf() - a.startOrder.valueOf());

	
// BLOG COLLECTION
const publishedBlogs = await getCollection('posts', ({ data }) => {
  return data.status === 'published';
});

const recentBlogs = (publishedBlogs)
.map(event => ({
	id: event.id,
	title: event.data.title,
	subtitle: event.data.subtitle,
	published: event.data.published,
	poster: event.data.coverImage,
	description: event.data.description,
	category: event.data.blogCategory,
	discipline: event.data.skateDiscipline,
	
}))
.sort((a, b) => {
    return new Date(b.published).getTime() - new Date(a.published).getTime();
  })
  .slice(0, 8);

const base = import.meta.env.BASE_URL;
---
	
<BaseLayout
title="Home Page">

<!-- {SHOW_JAN_BANNER && (
  <NoticeBanner 
    message={`Happy New Year! Check out the fresh ${CURRENT_YEAR} Jam List.`} 
  />
)} -->

<!-- {SHOW_NOV_BANNER && (
  <NoticeBanner 
	id="jan-jam-2026" 
	targetDate={new Date('2026-01-01')} 
	message="The Big Jam begins..." 
	/>
)} -->

	<!------------------------------------------ HERO ---------------->
	<section  id="hero-section" class="frame-fence">
		<Hero />
	</section>

	<!------------------------------------------ MISSION ---------------->
	<section id="our-mission" class="frame-fence">
	<div class="direction-box">
		<div class="heading-banner">
			<h3 class="heading">Helping skater's skate</h3>
			<span class="heading-sub">Mission Statement: "For the Skaters"</span>
		</div>
		
		<div class="nav-button center-flex">
			<Button href="/about" variant="primary" theme="brownDark" size="lg" class=""> Read about Us </Button>
			<Button href="/about" variant="primary" theme="orangeDark" size="lg" class=""> Newsletter Sign-up </Button>
		</div>
	</div>
		
	</section>
	<!------------------------------------------ FEATURES ---------------->
	{featuredEvents.length > 0 ? (
		<section id="feature-section"  class="frame-fence">
			<h3 class="heading">Featured Events</h3>
			<div class="carosel">
		{/* {featuredEvents.map((post) => (
			<FeaturedCard timeframe={post.timeframe} title={post.title} url={`/events/${post.id}/`} poster={post.poster} description={post.description} city={post.city} country={post.country} eventType={post.eventType}/>
			))} */}
			{featuredEvents.map(post => (
			<FeaturedCard {...post} />
			))}
			</div>
			<div class='big-space'></div>
		</section>
	) : (<span class="decor-alt"></span>) } 

	<!------------------------------------------ JAM LIST ---------------->
	<section id="festival-list" class="frame-fence">
		<div class="center-div">
			<div class="items-center">
				<h3 class="title"> Big Jam List <span class="year-highlight">2026</span> </h3>
			</div>
			<div class="items-center">
				<Button href="/festivals" variant="tertiary" theme="pinkLight" size="lg"> Find Skate Festivals </Button>
			</div>
		</div>
	</section>
	<!------------------------------------------ DIRECTORY ---------------->
	<section id="learn-to-skate" class="frame-fence ">
		<div class="direction-box">
			<div class="heading-banner">
				<h3 class="heading">To the directory</h3>
				<span class="heading-sub">Your A-to-Z of Skating</span>
				<p class="direct-sub">Find rinks, skate shops and community groups who hold lessons or events</p>
			</div>
			<div class="nav-button center-flex">
				<Button href="/directory" variant="primary" theme="brownDark" size="lg"> Browse the UK Directory </Button>
			</div>
		</div>
	
	</section>
	<!------------------------------------------ UPCOMING ---------------->
	<section id="upcoming-events" class="frame-fence side-by-side" >
		<div class="side-a">
			<h3>Upcoming Events</h3>
			<div><Button href="/events" variant="secondary" theme="brown" size="lg"> See All Events </Button></div>
			<p>Find your next skate event.</p>
		</div>
		<div class=" event-previews side-b">

			{upcomingEvents.length > 0 ? (
				<div class="carosel" role="list" aria-label="Upcoming Events">
			{upcomingEvents.map((post) => (
				<CardHolder 
				variant="event"
				title={post.title}
				url={`/events/${post.id}/`}
				poster={post.poster}
				city={post.city}
				country={post.country}
				timeframe={post.timeframe}
				description={post.description}
				eventType={post.eventType}
				/>
			))}

			<CardHolder 
				variant="placeholder"
				title="See more Events"
				url="/events"
				description="Browse All Events"
			/>
			</div> ) 
			: 
			// OR show none returned
			(<div class="none-returned"><p>No events to show yet</p> <p>Come back Tomorrow</p> </div>)}
			
		</div>

	</section>
	<!------------------------------------------ BLOGS ---------------->
	<section id="skate-news" class="frame-fence side-by-side">
		<div class="side-a">
			<h3>Skate News</h3>
			<span>Our latest blog posts on all things SKATE!</span>
			<div><Button href="/blog" variant="secondary" theme="brown" size="lg"> See All Blog Posts </Button></div>
		</div>
		<div class="side-b">
			{recentBlogs.length > 0 ? (
				<div class="carosel" role="list" aria-label="Recent Blog Posts"> 
			{recentBlogs.map((post) =>
				( <CardHolder variant="blog" 
				title={post.title} 
				url={`/blog/post/${post.id}/`} 
				poster={post.poster}
				subtitle={post.subtitle}  
				description={post.description} 
				category={post.category} 
				discipline={post.discipline}
				/>
			))}
				<CardHolder 
				variant="placeholder" 
				title="See more Posts" 
				url="/blog/" 
				description="Browse More Blog Posts" 
				/>
			</div> ) 
			: 
			(<div class="none-returned"><p>~No blog posts yet~</p></div>)}
			
		</div>
	</section>
	
</BaseLayout>

