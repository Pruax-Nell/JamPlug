---
import "../styles/event.css"; 
import Button from "../components/button.astro";
import BaseLayout from "../layouts/baseLayout.astro";
import { Image } from "astro:assets";

import type { BlogCategory, SkateDisciplines, SkillLevel, EventType, PostStatus, socialMedia, EventStatus, Footwear, MonthOrder, } from '../data/skate-constants';
// import { SerializedEvent } from "../types";

import HalfImage from '../assets/test1.jpg'
import EventsOG from '../../public/admin/events-og-image.jpg'
import PosterPlaceholder from '../assets/placeholder/placeholder-eventPoster.jpg';

import { getCollection, type CollectionEntry } from "astro:content";
import UpcomingEvents from '../components/upcomingEvents'; 

const now = new Date();
now.setHours(0, 0, 0, 0);

const publishedEvents: CollectionEntry<'events'>[] = await getCollection('events', ({ data }: CollectionEntry<'events'>) => {
  return data.status === 'published';
});

const ages = new Set<string>();
 
const clientUpcomingEvents = publishedEvents
  .filter((event) => event.data.startDate >= now)
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .map((event) => {
    const d = event.data;
    if (d.minAge) ages.add(d.minAge);

	// const posterString = (d.eventPoster && typeof d.eventPoster === 'object' 
	// ? d.eventPoster.src 
	// : d.eventPoster) || PosterPlaceholder.src;

	const posterObject = d.eventPoster ? {
      src: typeof d.eventPoster.src === 'object' ? d.eventPoster.src.src : d.eventPoster.src,
      alt: d.eventPoster.alt || d.eventName, 
      caption: d.eventPoster.caption || ""
    } : null;
 
    return {
      id: event.id,
	  slug: event.id,
      data: {
        eventName: d.eventName,
        townCity: d.townCity,
        location: d.location, 
        startDate: d.startDate.toISOString(),
        endDate: d.endDate?.toISOString() || null,
        skateDiscipline: d.skateDiscipline as SkateDisciplines,
        skillLevel: d.skillLevel as SkillLevel,
        eventType: d.eventType as EventType,
        eventPoster: posterObject,
        minAge: d.minAge,
        footwear: d.footwear as Footwear,
        rink: d.rink || ""
      },
    };
  });

	const serverOptions = {
	minAge: Array.from(ages).sort((a, b) => parseInt(a) - parseInt(b)),
};

const base = import.meta.env.BASE_URL;
---
<BaseLayout 
  title="International Roller Skate Events"
  description="Find your local Skate Events, from workshops to festivals."
  image={EventsOG}
>
<!-- ||-----------------------------------------------INTRO SECTION -->

<section id="events-header" class="frame-fence page-head">
		<hgroup class="header-group"> 
			<h1>Events</h1>
			<p>Find Roller skate events happening all over Europe. Small jams, weekend festivals, workshops and more.</p>
		</hgroup>
</section>
<!-- ||-----------------------------------------------SCRIBE SECTION -->

<section class="frame-fence scribe">
		
	<div class="jam-link-block">
		<h3 id="jam-list-heading">Big Jam List</h3>
		<Button href="/festivals" variant="secondary" size="lg"> Read More </Button>
		<span>Find all of Europes multi-day skate festivals</span>
	</div>
</section>
<!-- ||-----------------------------------------------EVENTS SECTION -->
<section class="frame-fence events-list">
	<!-- ||------------------------------------------EVENTS TEST -->
		
	<div class="header-group">
		<span>Roller skate events</span>
		<h2>Upcoming Events</h2>
	</div>

	<UpcomingEvents 
		client:load
		initialEvents={clientUpcomingEvents}
		serverOptions={serverOptions}
	/>
 
</section>
<!-- ||------------------------------------------------50/50 SECTION -->

<section class="frame-fence fifty-fifty-section">
	<div class="half-box">
		<div class="image">
			<Image src={HalfImage} alt="Group photo at RDV Paris" id="half-img" width={1200}>
			
		</div>
		<div class="content-wrap">
			<div class="inner-wrap">
				<h2>Submit an Event</h2>
				<p>Have an Event, Competition, Jam or Tour to tell us about? We aim to add events weekly, so use the button below to spread the word!</p>
				<div class="btn-wrap">
					<Button href="/submit-an-event" variant="secondary" size="md" > Read More </Button>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- ||-----------------------------------------------PAST SECTION -->

<section class="frame-fence past-events">
	<!-- past events -->
	<div class="primary-container">
		<div>
			<h3>Last Month's Events</h3>
		</div>
		<!-- {pastEvents.length > 0 ? (
		<div class="event-grid"> 
			{pastEvents.map((post )  =>
				( <EventCard 
				/>)
			)}
		</div>) : 
		(<div class="none-returned"><p>no events found</p></div>)
		} -->

	</div>
</section>
</BaseLayout>

