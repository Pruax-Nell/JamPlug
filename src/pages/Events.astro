---
import "../styles/event.css" ;
import BaseLayout from "../layouts/baseLayout.astro";

import { getCollection } from "astro:content";


// rebuild in react file
import EventCard from '../components/eventCard.astro';
import SearchComponent from "../components/searchFilter.astro";

import UpcomingEvents from '../components/eventPagination'

const now = new Date();
now.setHours(0, 0, 0, 0);

// All events which status is 'published'
const publishedEvents = await getCollection('events', ({ data }) => {
	return data.status === 'published';
});

// all 'published' events that are in the future
const upcomingEvents = (publishedEvents)
	.filter(
		event => {
			return event.data.startDate >= now;
		})
	.sort(
	(a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf(),
	);

	// all published events that are in the past
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(now.getDate() - 30);

// PAST EVENTS
const pastEvents = publishedEvents
  .filter(event => {
	const dateCompare = event.data.endDate || event.data.startDate;

	const eventEndDate = new Date(dateCompare);

	return eventEndDate <= now && eventEndDate >= thirtyDaysAgo;
  })
  .sort((a, b) => {
    // Sort by start date descending (most recent first)
    return new Date(b.data.startDate).valueOf() - new Date(a.data.startDate).valueOf();
  });
 
	
// 3. DATA SERIALIZATION (Crucial for React Props)
const clientUpcomingEvents = upcomingEvents.map(event => ({
    id: event.id,
    data: {
        ...event.data,
        startDate: event.data.startDate.toISOString(),
        endDate: event.data.endDate ? event.data.endDate.toISOString() : null,
        // Any other Date objects must be converted here too!
    },
}));

---

