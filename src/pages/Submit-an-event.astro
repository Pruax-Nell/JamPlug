---

import BaseLayout from "../layouts/baseLayout.astro";

// event forms
import FormOther from "../components/form/formOther.astro"
import FormNight from "../components/form/formNight.astro"
import FormSocial from "../components/form/formSocial.astro"
import FormWeekend from "../components/form/formWeekend.astro"
import FormWorkshop from "../components/form/formWorkshop.astro"
import FormFestival from "../components/form/formfestival.astro"


// styled button
import Button from "../components/button.astro";

import "../styles/global.css";
import "../styles/submit.css";

---

<BaseLayout
title="Submit your Roller Skate Event"> 
<nav class="navigation-controls">
    <Button  variant="outline" size="xs" theme="brown" class="back-button" onclick="history.length > 1 ? history.back() : window.location.href='/events'"> ← Previous Page </Button>
</nav>
<section class="form-fence">
    <hgroup class="submission-title">
        <h1>Submit your Event</h1>
        <p>For events to be listed on this site, use the forms below</p>
    </hgroup>
</section>

<section class="form-fence tally-form">
    <div class="form-wrap">

        <iframe 
        data-tally-src="https://tally.so/embed/Mez74X?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&formEventsForwarding=1" 
        loading="lazy" 
        width="100%" 
        height="600" 
        frameborder="0" 
        marginheight="0" 
        marginwidth="0" 
        title="Event Submission Form"
        ></iframe>
        
    </div>
</section>

