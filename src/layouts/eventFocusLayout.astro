---
import BaseLayout from './baseLayout.astro';
import { Image } from 'astro:assets';

import '../styles/event.css'
import '../styles/components.css'

interface Props {
  event: any; // Using any for brevity, or use CollectionEntry<'events'>
  children?: any; 
}

const { event } = Astro.props;
const { data } = event;

function formatTime(timeObj: any) {
  if (!timeObj || typeof timeObj !== 'object') return '';
  const { hour, minute } = timeObj;
  
  const h = parseInt(hour);
  const ampm = h >= 12 ? 'PM' : 'AM';
  const displayHour = h % 12 || 12;
  
  return `${displayHour}:${minute.toString().padStart(2, '0')} ${ampm}`;
}

const displayDate = new Date(data.startDate).toLocaleDateString('en-GB', {
  weekday: 'short', day: 'numeric', month: 'long'
});

const base = import.meta.env.BASE_URL;
---
<BaseLayout page_title={data.eventName} >
  <div class="">
    <nav class="navigation-controls">
      <button id="back-button" class="back-button">← Back to Events</button>
    </nav>
  </div>

  <div>
    <Image 
      src={data.eventPoster} 
      alt={data.eventName} 
      width={350} 
      height={510} 
      class="cover-image"
    />
 
  </div>

  <div>
    <div>
      {formatTime(data.startTime)} 
      {data.endTime && ` - ${formatTime(data.endTime)}`}
    </div>
    <p>{data.description}</p>
    <span>{data.startTime} </span> <span> ~ </span> <span>{data.endTime} </span>
    <p class="time-location">
      <strong>{displayDate}</strong> • {formatTime(data.startTime)} 
      {data.endTime && ` - ${formatTime(data.endTime)}`}
    </p>
  </div>

    <div class="content-slot">
      <slot />
    </div>

  <div class="primary-container">
    <div class="tags">
      <span>{data.skateDiscipline}</span>
      <span>{data.eventType}</span>
    </div>

  </div>

  <div>
    <nav class="navigation-controls">
      <button id="back-button" class="back-button">← Back to Events</button>
    </nav>
  </div>

</BaseLayout>

<script>
  // Robust back button handling
  document.getElementById('back-button')?.addEventListener('click', () => {
    if (document.referrer.includes(window.location.host)) {
      history.back();
    } else {
      window.location.href = '/events';
    }
  });
</script>

<style>
  .back-button {
    cursor: pointer;
    background: none;
    border: 1px solid #ddd;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: bold;
    transition: all 0.2s;
  }
  .back-button:hover {
    border-color: #4f46e5;
    color: #4f46e5;
  }
</style>


