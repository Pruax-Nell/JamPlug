---
import BaseLayout from "./baseLayout.astro";
import { Image } from 'astro:assets';

const { frontmatter } = Astro.props;
const { title, published, coverImage, description, tags, gallery } = frontmatter;

const base = import.meta.env.BASE_URL;
---

<BaseLayout >
    <h1>{title}</h1>
    <p>Published on: {published.toString().slice(0,10)}</p>
    <p>{published.toLocaleDateString()}</p>
    
    <p>{description}</p>

    <Image 
    src={coverImage} 
    alt={title} 
    width={350} 
    height={510} 
    class="cover-image"
    />
    
    <div class="content">
        <slot />
    </div>

    {gallery && (
        <section class="gallery-grid">
            {gallery.map((item:any) => (
            <figure>
                <Image 
                src={item.image} 
                alt={item.alt} 
                width={450} 
                format="avif"
                class="rounded-lg shadow-md"
                />
                <figcaption>{item.alt}</figcaption>
            </figure>
            ))} 
        </section>
    )}

    {tags && ( 
        <div class="tags">
            {tags.map((tag: string) => (
                <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
            ))}
        </div>
    )}

</BaseLayout>


