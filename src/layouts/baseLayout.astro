---
import "../styles/global.css";
import "../styles/components.css";
import "../styles/header.css"
import "../styles/footer.css";
import {SITE_TITLE, SITE_DESCRIPTION} from "../constants";

import Head from "../components/head.astro";
import Socials from "../components/socials.astro" ;

import Navigation from "../components/navigation.astro";
import Toolkit from "../components/toolkit.astro";
import FullNav from "../components/fullNav.astro";
import PageFooter from "../components/footer.astro";
 
interface Props { 
	page_title?: string;
	description?: string;
	Index?: string;
	SEO?: string;
	
}

const { page_title, Index, description, SEO } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<Head />
		<script is:inline>
			// This script runs immediately, preventing the "flash"
			const theme = (() => {
			if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
				return localStorage.getItem('theme');
			}
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				return 'dark';
			}
			return 'light';
			})();

			if (theme === 'dark') {
			document.documentElement.setAttribute('data-theme', 'dark');
			} else {
			document.documentElement.setAttribute('data-theme', 'light');
			}
			
			window.localStorage.setItem('theme', theme);
		</script>
	</head>

	<body >
	<section id="main-container">
		<div id="toolkit-container">
			<Toolkit/>
		</div>

		<section id="mainHeader"> 
			
			
			<!-- || page head and Nav -->
			<header id="site-header">
				<!-- A -->
				<div id="head-logo">
					<a href="/"><img src="/src/assets/branding/Shine-orange-lug-2.svg" alt="your Jam Plug" id="headLogo"></a>
				</div>
				<!-- B -->
				<div id=theNav">
					<Navigation />
					<FullNav />
				</div>

			</header>
		</section>

		<section id="mainBody">
			<!-- || Content slot -->
			<slot />
		</section>

		<section id="mainFooter">
			<PageFooter />
		</section>
	</section>
	</body>
	
	<script>
        import "../function/basic.js"

    </script>

</html>

