import fs from 'fs';
import path from 'path';
import { parse } from 'csv-parse/sync'; // npm install csv-parse

// 1. Read the CSV
const csvData = fs.readFileSync('./organisers.csv', 'utf-8');
const records = parse(csvData, { columns: true });

records.forEach((row) => {
