// website: "${row.website || ''}"
// description: "${row.description || ''}"
// ---`;

  // 3. Save the file to your content collection folder
  const filePath = path.join('src/content/organisers', `${slug}.mdoc`);
  
  if (!fs.existsSync('src/content/organisers')) {
    fs.mkdirSync('src/content/organisers', { recursive: true });
  }

  fs.writeFileSync(filePath, content);
