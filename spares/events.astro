---
import React, { useState, useMemo, useEffect } from 'react';

import "../styles/event.css" ;
import BaseLayout from "../layouts/baseLayout.astro";
import { getCollection } from "astro:content";

import EventCard from '../components/eventCard.astro';
import SearchComponent from "../components/searchFilter.astro";
import { supportsViewTransitions } from "astro:transitions/client";

// max no. of eventcards per pagination 
const EVENTS_PER_PAGE = 16;
const INITIAL_FILTERS = {
    country: 'All',
    eventType: 'All',
    skateDiscipline: 'All',
    minAge: 'All',
    skillLevel: 'All',
    month: 'All',
};

const now = new Date();

const publishedEvents = await getCollection('events', ({ data }) => {
	return data.status === 'published';
});


const upcomingEvents = (publishedEvents)
	.filter(
		event => {
			return event.data.startDate >= now;
		})
	.sort(
	(a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf(),
	);

const pastEvents = (publishedEvents)
	.filter(
	event => {
		return event.data.endDate <= now ;
	})
	.sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
	);
	
	
