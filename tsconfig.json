{  
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@branding/*": ["src/assets/YJP/*"],
      "@styles/*": ["src/styles/*"],
      "@admin/*": ["public/admin/*"],
      
    }
  }
}